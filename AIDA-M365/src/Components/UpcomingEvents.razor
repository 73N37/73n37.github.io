@page "/upcoming-events"
@using AIDA.M365.Models
@using Microsoft.AspNetCore.Components
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-6" Style="background-color: #FAF9F6; min-height: 100vh; font-family: 'Playfair Display', 'Inter', sans-serif;">
    <MudStack Spacing="6">
        
        <!-- Header Banner with Premium Aesthetics -->
        <MudPaper Class="pa-6 rounded-lg shadow-sm" Elevation="0" Style="background-color: white; border-bottom: 4px solid #D4AF37;">
            <MudGrid AlignItems="AlignItems.Center">
                <MudItem xs="12" md="5">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h4" Class="font-weight-bold" Style="color: #2C3E50; letter-spacing: -0.5px;">Godskalender & Belægning</MudText>
                        <MudText Typo="Typo.subtitle2" Style="color: #7F8C8D; font-weight: 300;">
                            Fælles kalender med tilgængelighed for Den Store Lade, Hovedbygningen og Søparken på Engestofte Gods.
                        </MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" md="7" Class="d-flex justify-md-end justify-start align-center gap-4 flex-wrap">
                    <!-- Hybrid Access Control Toggle -->
                    <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Style="border-radius: 8px;">
                        <MudButton OnClick="() => SetAccessMode(true)" 
                                   Variant="@(_isStaffView ? Variant.Filled : Variant.Outlined)"
                                   Style="@(_isStaffView ? "background-color: #2C3E50; color: white;" : "")">
                            Ansvarlig Koordinator
                        </MudButton>
                        <MudButton OnClick="() => SetAccessMode(false)" 
                                   Variant="@(!_isStaffView ? Variant.Filled : Variant.Outlined)"
                                   Style="@(!_isStaffView ? "background-color: #2C3E50; color: white;" : "")">
                            Offentlig Tilgængelighed
                        </MudButton>
                    </MudButtonGroup>

                    @if (_isStaffView)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Add" 
                                   Variant="Variant.Filled" 
                                   Color="Color.Secondary" 
                                   OnClick="OpenCreateDrawer" 
                                   Style="border-radius: 8px; background-color: #D4AF37; color: white; font-weight: bold; padding: 10px 20px;">
                            Opret Selskab
                        </MudButton>
                    }

                    <MudMenu StartIcon="@Icons.Material.Filled.Download" Label="Eksporter Program" Color="Color.Primary" Variant="Variant.Filled" Style="border-radius: 8px; background-color: #2C3E50; color: white; padding: 6px 12px;">
                        <MudMenuItem OnClick="SimulatePdfExport">Eksporter PDF Dagsorden</MudMenuItem>
                        <MudMenuItem OnClick="SimulateExcelExport">Hent Forplejningsliste (Excel)</MudMenuItem>
                    </MudMenu>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- Dynamic Success Logs -->
        @if (!string.IsNullOrWhiteSpace(_logMessage))
        {
            <MudAlert Severity="Severity.Success" Dense="true" Variant="Variant.Outlined" Style="border-radius: 8px; border: 1px solid #D4AF37; background-color: white;">
                @_logMessage
            </MudAlert>
        }

        <!-- Calendar Month Navigation -->
        <MudPaper Class="pa-4 rounded-lg d-flex justify-between align-center" Elevation="0" Style="background-color: white;">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Color="Color.Primary" OnClick="PreviousMonth" />
            <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: #2C3E50; text-transform: capitalize;">@_currentDate.ToString("MMMM yyyy", new System.Globalization.CultureInfo("da-DK"))</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Primary" OnClick="NextMonth" />
        </MudPaper>

        <!-- Custom high-fidelity monthly calendar grid -->
        <MudPaper Class="pa-4 rounded-lg" Outlined="true" Style="background-color: white;">
            <!-- Day of Week Headers -->
            <MudGrid Spacing="1" Class="mb-2">
                @foreach (var dayName in _dayNames)
                {
                    <MudItem xs="1" Style="width: 14.28%; max-width: 14.28%; flex-basis: 14.28%;">
                        <MudPaper Class="pa-2 text-center" Elevation="0" Style="background-color: #FAF9F6;">
                            <MudText Typo="Typo.caption" Class="font-weight-bold" Style="color: #2C3E50;">@dayName</MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>

            <!-- Calendar Days Grid -->
            <MudGrid Spacing="1">
                @foreach (var cell in _calendarCells)
                {
                    <MudItem xs="1" Style="width: 14.28%; max-width: 14.28%; flex-basis: 14.28%;">
                        <MudPaper Class="pa-2 rounded-lg d-flex flex-column justify-between calendar-day-cell" 
                                  Outlined="true" 
                                  Style="@GetDayCellStyle(cell)"
                                  Elevation="0"
                                  @onclick="() => OnCellClicked(cell.Date)">
                            <!-- Day Number -->
                            <MudStack Row="true" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.caption" 
                                         Class="@(cell.IsCurrentMonth ? "font-weight-bold text-dark" : "text-muted")"
                                         Style="@(cell.Date.Date == DateTime.Today ? "background-color: #D4AF37; color: white; padding: 2px 6px; border-radius: 50%;" : "")">
                                    @cell.Date.Day
                                </MudText>
                            </MudStack>

                            <!-- Events List inside Day Cell -->
                            <div class="mt-2 d-flex flex-column gap-1" style="min-height: 80px;">
                                @foreach (var card in cell.Cards)
                                {
                                    <div class="pa-2 rounded text-truncate hover-card" 
                                         style="@GetCardStyle(card)"
                                         @onclick="() => OpenEventDetails(card)"
                                         @onclick:stopPropagation="true">
                                        @if (_isStaffView)
                                        {
                                            <MudText Typo="Typo.caption" Class="font-weight-bold text-truncate d-block">
                                                @card.Subject
                                            </MudText>
                                            <MudText Typo="Typo.caption" Style="font-size: 0.7rem; color: #555;" Class="d-block text-truncate">
                                                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Style="font-size: 0.75rem; vertical-align: middle; margin-right: 2px;" />
                                                @card.GuestCount Gæster
                                            </MudText>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Class="font-weight-bold text-truncate d-block text-center" Style="font-style: italic; color: #555;">
                                                Reserveret
                                            </MudText>
                                            <MudText Typo="Typo.caption" Style="font-size: 0.65rem; color: #666;" Class="d-block text-center text-truncate">
                                                @card.EstateArea
                                            </MudText>
                                        }
                                    </div>
                                }
                            </div>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    </MudStack>
</MudContainer>

<!-- Detailed Action Drawer -->
<MudDrawer @bind-Open="_isDrawerOpen" Anchor="Anchor.Right" Width="480px" Elevation="4" Style="background-color: #FAF9F6; font-family: 'Inter', sans-serif; overflow-y: auto;">
    @if (_selectedCard is not null)
    {
        <MudStack Class="pa-6" Spacing="4">
            @if (_isDetailsEditing)
            {
                <!-- REDIGER DETALJER TILSTAND -->
                <MudStack Row="true" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: #2C3E50;">Rediger Selskab</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="() => _isDetailsEditing = false" />
                </MudStack>
                <MudDivider />

                <MudTextField @bind-Value="_editSubject" Label="Selskabsnavn / Emne" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                
                <MudDatePicker @bind-Date="_editDate" Label="Dato" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                
                <MudGrid Spacing="2">
                    <MudItem xs="6">
                        <MudTimePicker @bind-Time="_editStartTime" Label="Starttidspunkt" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTimePicker @bind-Time="_editEndTime" Label="Sluttidspunkt" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                    </MudItem>
                </MudGrid>

                <MudSelect @bind-Value="_editArea" Label="Vælg Område på Engestofte Gods" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@("Den Store Lade")">Den Store Lade</MudSelectItem>
                    <MudSelectItem Value="@("Hovedbygningen")">Hovedbygningen</MudSelectItem>
                    <MudSelectItem Value="@("Søparken")">Søparken</MudSelectItem>
                </MudSelect>

                <MudSelect @bind-Value="_editSubtype" Label="Kategori" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@("Bryllup")">Bryllup</MudSelectItem>
                    <MudSelectItem Value="@("Konference")">Konference</MudSelectItem>
                    <MudSelectItem Value="@("Privat Fest")">Privat Fest</MudSelectItem>
                    <MudSelectItem Value="@("Jagt & Event")">Jagt & Event</MudSelectItem>
                </MudSelect>

                <MudNumericField @bind-Value="_editGuestCount" Label="Antal Gæster" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" />

                <MudSelect @bind-Value="_editCatering" Label="Forplejning" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@("Gourmet Selskabsmenu")">Gourmet Selskabsmenu</MudSelectItem>
                    <MudSelectItem Value="@("Konference-dagsmenu")">Konference-dagsmenu</MudSelectItem>
                    <MudSelectItem Value="@("Brunch & Champagne")">Brunch & Champagne</MudSelectItem>
                </MudSelect>

                <MudTextField @bind-Value="_editCoordinator" Label="Ansvarlig Koordinator" Variant="Variant.Outlined" Margin="Margin.Dense" />

                <MudStack Row="true" Spacing="2" JustifyContent="JustifyContent.End" Class="mt-2">
                    <MudButton Variant="Variant.Outlined" OnClick="() => _isDetailsEditing = false" Style="border-radius: 8px;">Annuller</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEditedEvent" Style="background-color: #2C3E50; color: white; border-radius: 8px; font-weight: bold;">
                        Gem Ændringer
                    </MudButton>
                </MudStack>
            }
            else
            {
                <!-- LÆSE / DETALJER TILSTAND -->
                <MudStack Row="true" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudChip Size="Size.Medium" 
                             Color="@(_selectedCard.EventSubtype == "Bryllup" || _selectedCard.EventSubtype == "Wedding" ? Color.Secondary : Color.Primary)" 
                             Variant="Variant.Filled"
                             Class="font-weight-bold">
                        @(string.Equals(_selectedCard.EventSubtype, "Wedding", StringComparison.OrdinalIgnoreCase) ? "Bryllup" : string.Equals(_selectedCard.EventSubtype, "Birthday", StringComparison.OrdinalIgnoreCase) ? "Privat Fest" : _selectedCard.EventSubtype)
                    </MudChip>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="() => _isDrawerOpen = false" />
                </MudStack>

                <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: #2C3E50;">@_selectedCard.Subject</MudText>
                
                <MudDivider />

                <!-- Core Specs Grid -->
                <MudPaper Class="pa-4 rounded-lg" Outlined="true" Style="background-color: white;">
                    <MudStack Spacing="3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Primary" />
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Class="text-muted font-weight-bold">DATO & TIDSPUNKT</MudText>
                                <MudText Typo="Typo.body2">@_selectedCard.StartUtc.ToLocalTime().ToString("dd. MMM yyyy, HH:mm", new System.Globalization.CultureInfo("da-DK")) - @_selectedCard.EndUtc.ToLocalTime().ToString("HH:mm")</MudText>
                            </MudStack>
                        </MudStack>

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Place" Color="Color.Primary" />
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Class="text-muted font-weight-bold">RESERVERET OMRÅDE</MudText>
                                <MudText Typo="Typo.body2">@_selectedCard.EstateArea</MudText>
                            </MudStack>
                        </MudStack>

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" />
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Class="text-muted font-weight-bold">ANTAL GÆSTER</MudText>
                                <MudText Typo="Typo.body2">@_selectedCard.GuestCount Gæster</MudText>
                            </MudStack>
                        </MudStack>

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" />
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Class="text-muted font-weight-bold">ANSVARLIG KOORDINATOR</MudText>
                                <MudText Typo="Typo.body2">@_selectedCard.AssignedCoordinator</MudText>
                            </MudStack>
                        </MudStack>

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Restaurant" Color="Color.Primary" />
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Class="text-muted font-weight-bold">FORPLEJNINGSAFTALE</MudText>
                                <MudText Typo="Typo.body2">@_selectedCard.CateringOption</MudText>
                            </MudStack>
                        </MudStack>
                    </MudStack>
                </MudPaper>

                <!-- Timetable / Subevents Section -->
                <MudPaper Class="pa-4 rounded-lg" Outlined="true" Style="background-color: white;">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2" Style="color: #2C3E50;">Dagens Program (Del-begivenheder)</MudText>
                    
                    @if (_selectedCard.Subevents == null || _selectedCard.Subevents.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Class="text-muted d-block mb-2">Ingen del-begivenheder planlagt endnu.</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="2" Class="mb-3">
                            @foreach (var sub in _selectedCard.Subevents.OrderBy(s => s.StartTime))
                            {
                                <MudPaper Class="pa-3 rounded-lg" Outlined="true" Style="background-color: #FAF9F6; border-left: 4px solid #D4AF37;">
                                    <MudStack Row="true" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body2" Class="font-weight-bold" Style="color: #2C3E50;">@sub.Title</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Style="font-size: 0.8rem; vertical-align: middle; margin-right: 2px;" />
                                                @sub.StartTime.ToString(@"hh\:mm") - @sub.EndTime.ToString(@"hh\:mm")
                                                <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Style="font-size: 0.8rem; vertical-align: middle; margin-left: 6px; margin-right: 2px;" />
                                                @sub.Location
                                            </MudText>
                                        </MudStack>
                                        @if (_isStaffView)
                                        {
                                            <MudStack Row="true" Spacing="1">
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="() => StartEditSubevent(sub)" />
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteSubevent(sub)" />
                                            </MudStack>
                                        }
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    }

                    @if (_isStaffView)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="color: #7F8C8D;">TILFØJ / REDIGER AKTIVITET</MudText>
                        <MudStack Spacing="2">
                            <MudTextField @bind-Value="_subTitle" Label="Titel på aktivitet" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudGrid Spacing="2">
                                <MudItem xs="6">
                                    <MudTimePicker @bind-Time="_subStart" Label="Starttid" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="6">
                                    <MudTimePicker @bind-Time="_subEnd" Label="Sluttid" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                            </MudGrid>
                            <MudSelect @bind-Value="_subLocation" Label="Lokation" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="@("Den Store Lade")">Den Store Lade</MudSelectItem>
                                <MudSelectItem Value="@("Hovedbygningen")">Hovedbygningen</MudSelectItem>
                                <MudSelectItem Value="@("Søparken")">Søparken</MudSelectItem>
                            </MudSelect>
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SaveSubevent" Style="background-color: #D4AF37; color: white; border-radius: 8px; font-weight: bold;">
                                @(_editingSubeventId.HasValue ? "Opdater Aktivitet" : "Tilføj Aktivitet")
                            </MudButton>
                            @if (_editingSubeventId.HasValue)
                            {
                                <MudButton Variant="Variant.Outlined" OnClick="CancelEditSubevent" Style="border-radius: 8px;" Class="mt-1">Annuller redigering</MudButton>
                            }
                        </MudStack>
                    }
                </MudPaper>

                <!-- OpenAI Action Items -->
                @if (_selectedCard.ActionItems.Count > 0)
                {
                    <MudPaper Class="pa-4 rounded-lg" Outlined="true" Style="background-color: white; border-left: 4px solid #D4AF37;">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: #2C3E50;">Azure OpenAI Foreslået Huskeliste & Klargøring</MudText>
                            @foreach (var task in _selectedCard.ActionItems)
                            {
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckBoxOutlineBlank" Color="Color.Primary" Size="Size.Small" />
                                    <MudText Typo="Typo.caption" Class="text-muted">@task</MudText>
                                </MudStack>
                            }
                        </MudStack>
                    </MudPaper>
                }

                @if (_isStaffView)
                {
                    <MudButton StartIcon="@Icons.Material.Filled.Edit" 
                               Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               OnClick="EnableEditMode" 
                               Style="border-radius: 8px; background-color: #2C3E50; color: white; font-weight: bold; margin-top: 10px;">
                        Rediger Selskab
                    </MudButton>
                }
            }
        </MudStack>
    }Stack>
    }
</MudDrawer>

<!-- Opret Selskab Modal -->
@if (_isCreateDrawerOpen)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 1300;" @onclick="() => _isCreateDrawerOpen = false"></div>
    <MudPaper Elevation="8" Style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1301; width: 480px; max-width: calc(100vw - 32px); max-height: 90vh; overflow-y: auto; border-radius: 12px; background-color: #FAF9F6; font-family: 'Inter', sans-serif;">
        <MudStack Class="pa-6" Spacing="4">
            <MudStack Row="true" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: #2C3E50;">
                    @(_isStaffView ? "Opret Selskab" : "Send Forespørgsel om Reservation")
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="() => _isCreateDrawerOpen = false" />
            </MudStack>
            <MudDivider />

            <MudTextField @bind-Value="_newSubject"
                          Label="@(_isStaffView ? "Selskabsnavn / Emne" : "Dit Navn / Selskabsnavn")"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Required="true" />

            <MudDatePicker @bind-Date="_newDate"
                           Label="Dato"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Required="true"
                           PickerVariant="PickerVariant.Static"
                           Style="background-color: white; border-radius: 8px;" />

            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudTimePicker @bind-Time="_newStartTime" Label="Starttidspunkt" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                </MudItem>
                <MudItem xs="6">
                    <MudTimePicker @bind-Time="_newEndTime" Label="Sluttidspunkt" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                </MudItem>
            </MudGrid>

            <MudSelect @bind-Value="_newArea" Label="Lokation på Engestofte Gods" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("Den Store Lade")">Den Store Lade</MudSelectItem>
                <MudSelectItem Value="@("Hovedbygningen")">Hovedbygningen</MudSelectItem>
                <MudSelectItem Value="@("Søparken")">Søparken</MudSelectItem>
            </MudSelect>

            <MudSelect @bind-Value="_newSubtype" Label="Kategori" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("Bryllup")">Bryllup</MudSelectItem>
                <MudSelectItem Value="@("Konference")">Konference</MudSelectItem>
                <MudSelectItem Value="@("Privat Fest")">Privat Fest</MudSelectItem>
                <MudSelectItem Value="@("Jagt & Event")">Jagt & Event</MudSelectItem>
            </MudSelect>

            <MudNumericField @bind-Value="_newGuestCount" Label="Antal Gæster" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" />

            <MudSelect @bind-Value="_newCatering" Label="Forplejning" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("Gourmet Selskabsmenu")">Gourmet Selskabsmenu</MudSelectItem>
                <MudSelectItem Value="@("Konference-dagsmenu")">Konference-dagsmenu</MudSelectItem>
                <MudSelectItem Value="@("Brunch & Champagne")">Brunch & Champagne</MudSelectItem>
            </MudSelect>

            @if (_isStaffView)
            {
                <MudTextField @bind-Value="_newCoordinator" Label="Ansvarlig Koordinator" Variant="Variant.Outlined" Margin="Margin.Dense" />
            }

            <MudStack Row="true" Spacing="2" JustifyContent="JustifyContent.FlexEnd">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="() => _isCreateDrawerOpen = false" Style="border-radius: 8px;">
                    Annuller
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveNewReservation" Style="background-color: #2C3E50; color: white; border-radius: 8px; font-weight: bold;">
                    @(_isStaffView ? "Gem Selskab" : "Send Forespørgselsmail")
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
}

<style>
    .hover-card {
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    
    .hover-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 6px rgba(0,0,0,0.08);
    }

    .calendar-day-cell {
        transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
    }
    
    .calendar-day-cell:hover {
        background-color: #FAF6EE !important; /* Soft Linen-Cream hover color */
        border-color: #D4AF37 !important; /* Elegant Gold border focus */
    }
</style>

@code {
