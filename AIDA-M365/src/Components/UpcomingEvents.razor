    private void GenerateCalendarGrid()
    {
        _calendarCells.Clear();

        var firstDayOfMonth = new DateTime(_currentDate.Year, _currentDate.Month, 1);
        
        // Find how many padding cells we need at start (adjusting for Mon-Sun grid)
        int offset = ((int)firstDayOfMonth.DayOfWeek - 1 + 7) % 7;
        var startDay = firstDayOfMonth.AddDays(-offset);

        // Fill exactly 35 cells representing 5 calendar weeks
        for (int i = 0; i < 35; i++)
        {
            var date = startDay.AddDays(i);
            
            // Link matching events falling on this date
            var dayEvents = _allCards.Where(c => c.StartUtc.Date == date.Date).ToList();

            _calendarCells.Add(new CalendarDayCell
            {
                Date = date,
                IsCurrentMonth = date.Month == _currentDate.Month,
                Cards = dayEvents
            });
        }
    }

    private string GetDayCellStyle(CalendarDayCell cell)
    {
        var style = "background-color: white; min-height: 120px; border: 1px solid #ECEFF1; cursor: pointer;";
        if (!cell.IsCurrentMonth)
        {
            style += " opacity: 0.4; background-color: #ECEFF1;";
        }
        return style;
    }

    private string GetCardStyle(KanbanEventCard card)
    {
        var baseStyle = "border-radius: 4px; padding: 4px 8px; font-size: 0.8rem;";
        if (card.EventSubtype == "Bryllup" || card.EventSubtype == "Wedding")
        {
            // Orchid/Lavender theme for Bryllup
            baseStyle += " background-color: #F3E5F5; border-left: 4px solid #9c27b0; color: #4A148C;";
        }
        else if (card.EventSubtype == "Konference" || card.EventSubtype == "Conference")
        {
            // Teal/Sage theme for Konference
            baseStyle += " background-color: #E0F2F1; border-left: 4px solid #009688; color: #004D40;";
        }
        else if (card.EventSubtype == "Privat Fest" || card.EventSubtype == "Birthday")
        {
            // Pink/Rose theme for Privat Fest
            baseStyle += " background-color: #FCE4EC; border-left: 4px solid #e91e63; color: #880E4F;";
        }
        else
        {
            // Orange/Gold for Jagt & Event and others
            baseStyle += " background-color: #FFF3E0; border-left: 4px solid #ff9800; color: #E65100;";
        }
        return baseStyle;
    }

