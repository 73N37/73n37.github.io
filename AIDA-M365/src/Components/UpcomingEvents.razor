@code {
    private DateTime _currentDate = DateTime.Today;
    private bool _isStaffView = true;
    private string? _logMessage;
    private string _activeLocationFilter = string.Empty;
    private bool _showAllThreeCalendars = false;

    private readonly string[] _dayNames = ["Man", "Tir", "Ons", "Tor", "Fre", "Lør", "Søn"];
    private readonly List<CalendarDayCell> _calendarCells = [];
    private readonly List<KanbanEventCard> _allCards = [];

    private bool _isDrawerOpen;
    private KanbanEventCard? _selectedCard;

    // Create Drawer variables
    private bool _isCreateDrawerOpen;
    private string _newSubject = string.Empty;
    private DateTime? _newDate = DateTime.Today;
    private TimeSpan? _newStartTime = new TimeSpan(11, 0, 0);
    private TimeSpan? _newEndTime = new TimeSpan(18, 0, 0);
    private string _newArea = "Den Store Lade";
    private string _newSubtype = "Bryllup";
    private int _newGuestCount = 100;
    private string _newCatering = "Gourmet Selskabsmenu";
    private decimal _newPrice = 0;
    private string _newCoordinator = "Sarah Jenkins";

    // Main Event Edit variables inside Details Drawer
    private bool _isDetailsEditing;
    private string _editSubject = string.Empty;
    private DateTime? _editDate = DateTime.Today;
    private TimeSpan? _editStartTime = new TimeSpan(11, 0, 0);
    private TimeSpan? _editEndTime = new TimeSpan(18, 0, 0);
    private string _editArea = "Den Store Lade";
    private string _editSubtype = "Bryllup";
    private int _editGuestCount = 100;
    private string _editCatering = "Gourmet Selskabsmenu";
    private string _editCoordinator = "Sarah Jenkins";

    // Inline Subevent variables inside Details Drawer
    private string _subTitle = string.Empty;
    private TimeSpan? _subStart = new TimeSpan(12, 0, 0);
    private TimeSpan? _subEnd = new TimeSpan(13, 0, 0);
    private string _subLocation = "Den Store Lade";
    private Guid? _editingSubeventId;

    protected override async Task OnInitializedAsync()
    {
        StateContainer.OnChange += OnStateChanged;
        await LoadEventsAsync();
    }

    private async Task LoadEventsAsync()
    {
        var events = await PostgresService.FetchAllEventsAsync();
        _allCards.Clear();
        _allCards.AddRange(events);
        GenerateCalendarGrid();
        StateHasChanged();
    }

    private async void OnStateChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadEventsAsync();
        });
    }

    public void Dispose()
    {
        StateContainer.OnChange -= OnStateChanged;
    }

    private List<CalendarDayCell> GetCellsForLocation(string? location)
    {
        var cells = new List<CalendarDayCell>();
        var firstDayOfMonth = new DateTime(_currentDate.Year, _currentDate.Month, 1);
        
        // Find how many padding cells we need at start (adjusting for Mon-Sun grid)
        int offset = ((int)firstDayOfMonth.DayOfWeek - 1 + 7) % 7;
        var startDay = firstDayOfMonth.AddDays(-offset);

        // Fill exactly 35 cells representing 5 calendar weeks
        for (int i = 0; i < 35; i++)
        {
            var date = startDay.AddDays(i);
            
            // Link matching events falling on this date and matching location if filtered
            var dayEvents = _allCards.Where(c => c.StartUtc.Date == date.Date &&
                (string.IsNullOrEmpty(location) || string.Equals(c.EstateArea, location, StringComparison.OrdinalIgnoreCase))).ToList();

            cells.Add(new CalendarDayCell
            {
                Date = date,
                IsCurrentMonth = date.Month == _currentDate.Month,
                Cards = dayEvents
            });
        }
        return cells;
    }

    private void GenerateCalendarGrid()
    {
        _calendarCells.Clear();
        _calendarCells.AddRange(GetCellsForLocation(_activeLocationFilter));
    }

    private string GetDayCellStyle(CalendarDayCell cell)
    {
        var style = "background-color: white; min-height: 120px; border: 1px solid #ECEFF1; cursor: pointer;";
        if (!cell.IsCurrentMonth)
        {
            style += " opacity: 0.4; background-color: #ECEFF1;";
        }
        return style;
    }

    private string GetCardStyle(KanbanEventCard card)
    {
        var baseStyle = "border-radius: 4px; padding: 4px 8px; font-size: 0.8rem;";
        if (card.EventSubtype == "Bryllup" || card.EventSubtype == "Wedding")
        {
            // Orchid/Lavender theme for Bryllup
            baseStyle += " background-color: #F3E5F5; border-left: 4px solid #9c27b0; color: #4A148C;";
        }
        else if (card.EventSubtype == "Konference" || card.EventSubtype == "Conference")
        {
            // Teal/Sage theme for Konference
            baseStyle += " background-color: #E0F2F1; border-left: 4px solid #009688; color: #004D40;";
        }
        else if (card.EventSubtype == "Privat Fest" || card.EventSubtype == "Birthday")
        {
            // Pink/Rose theme for Privat Fest
            baseStyle += " background-color: #FCE4EC; border-left: 4px solid #e91e63; color: #880E4F;";
        }
        else
        {
            // Orange/Gold for Jagt & Event and others
            baseStyle += " background-color: #FFF3E0; border-left: 4px solid #ff9800; color: #E65100;";
        }
        return baseStyle;
    }

    private void SetAccessMode(bool isStaff)
    {
        _isStaffView = isStaff;
        _logMessage = $"[Adgangskontrol] Skiftede til {(_isStaffView ? "Gods-koordinator" : "Offentlig tilgængelighed (Skrivebeskyttet)")} kalendervisning.";
        StateHasChanged();
    }

    private void ToggleCalendarLayout()
    {
        _showAllThreeCalendars = !_showAllThreeCalendars;
        if (!_showAllThreeCalendars)
        {
            GenerateCalendarGrid();
        }
        StateHasChanged();
    }

    private void FilterByLocation(string location)
    {
        _activeLocationFilter = location;
        GenerateCalendarGrid();
        StateHasChanged();
    }

    private async Task OpenEventDetails(KanbanEventCard card)
    {
        _logMessage = $"[Database] Henter seneste detaljer for '{card.Subject}' fra databasen...";
        StateHasChanged();

        try
        {
            // Pull the latest, fresh data from the database spejling to ensure real-time client views
            var events = await PostgresService.FetchAllEventsAsync();
            var freshCard = events.FirstOrDefault(e => e.GraphEventId == card.GraphEventId);
            if (freshCard != null)
            {
                _selectedCard = freshCard;
                _logMessage = $"[Succes] Opdaterede detaljer for '{freshCard.Subject}' direkte fra databasen.";
            }
            else
            {
                _selectedCard = card;
                _logMessage = $"[Info] Viser selskab '{card.Subject}' fra lokal hukommelse.";
            }
        }
        catch (Exception)
        {
            _selectedCard = card;
            _logMessage = $"[Advarsel] Kunne ikke forbinde til databasen. Viser lokal kopi af '{card.Subject}'.";
        }

        _isDetailsEditing = false; // Reset to details mode
        CancelEditSubevent();      // Reset subevent form
        _isDrawerOpen = true;
        StateHasChanged();
    }

    private void EnableEditMode()
    {
        if (_selectedCard is null) return;
        
        _editSubject = _selectedCard.Subject;
        _editDate = _selectedCard.StartUtc.ToLocalTime().Date;
        _editStartTime = _selectedCard.StartUtc.ToLocalTime().TimeOfDay;
        _editEndTime = _selectedCard.EndUtc.ToLocalTime().TimeOfDay;
        _editArea = _selectedCard.EstateArea ?? "Den Store Lade";
        _editSubtype = _selectedCard.EventSubtype ?? "Bryllup";
        _editGuestCount = _selectedCard.GuestCount;
        _editCatering = _selectedCard.CateringOption ?? "Gourmet Selskabsmenu";
        _editCoordinator = _selectedCard.AssignedCoordinator ?? "";

        _isDetailsEditing = true;
    }

    private async Task SaveEditedEvent()
    {
        if (_selectedCard is null) return;

        if (string.IsNullOrWhiteSpace(_editSubject))
        {
            _logMessage = "[Systemfejl] Selskabsnavn skal udfyldes.";
            return;
        }

        if (!_editDate.HasValue || !_editStartTime.HasValue || !_editEndTime.HasValue)
        {
            _logMessage = "[Systemfejl] Dato og klokkeslæt skal angives.";
            return;
        }

        var localStart = _editDate.Value.Date.Add(_editStartTime.Value);
        var localEnd = _editDate.Value.Date.Add(_editEndTime.Value);
        
        if (localEnd <= localStart)
        {
            _logMessage = "[Systemfejl] Sluttidspunkt skal være efter starttidspunkt.";
            return;
        }

        _selectedCard.Subject = _editSubject;
        _selectedCard.StartUtc = new DateTimeOffset(localStart, TimeZoneInfo.Local.GetUtcOffset(localStart));
        _selectedCard.EndUtc = new DateTimeOffset(localEnd, TimeZoneInfo.Local.GetUtcOffset(localEnd));
        _selectedCard.EstateArea = _editArea;
        _selectedCard.EventSubtype = _editSubtype;
        _selectedCard.GuestCount = _editGuestCount;
        _selectedCard.CateringOption = _editCatering;
        _selectedCard.AssignedCoordinator = _editCoordinator;
        _selectedCard.ColorHex = GetColorForSubtype(_editSubtype);

        await PostgresService.SaveEventAsync(_selectedCard);

        var events = await PostgresService.FetchAllEventsAsync();
        _allCards.Clear();
        _allCards.AddRange(events);

        GenerateCalendarGrid();
        _isDetailsEditing = false;
        _logMessage = $"[Succes] Ændringer for selskabet '{_selectedCard.Subject}' blev gemt.";
        StateHasChanged();
    }

    private void StartEditSubevent(Subevent sub)
    {
        _editingSubeventId = sub.Id;
        _subTitle = sub.Title;
        _subStart = sub.StartTime;
        _subEnd = sub.EndTime;
        _subLocation = sub.Location;
    }

    private void CancelEditSubevent()
    {
        _editingSubeventId = null;
        _subTitle = string.Empty;
        _subStart = new TimeSpan(12, 0, 0);
        _subEnd = new TimeSpan(13, 0, 0);
        _subLocation = "Den Store Lade";
    }

    private async Task SaveSubevent()
    {
        if (_selectedCard is null) return;

        if (string.IsNullOrWhiteSpace(_subTitle))
        {
            _logMessage = "[Systemfejl] Aktivitetstitel skal udfyldes.";
            return;
        }

        if (!_subStart.HasValue || !_subEnd.HasValue)
        {
            _logMessage = "[Systemfejl] Start- og sluttid skal angives.";
            return;
        }

        if (_subEnd.Value <= _subStart.Value)
        {
            _logMessage = "[Systemfejl] Sluttid skal være efter starttid.";
            return;
        }

        if (_editingSubeventId.HasValue)
        {
            // Edit existing subevent
            var sub = _selectedCard.Subevents.FirstOrDefault(s => s.Id == _editingSubeventId.Value);
            if (sub != null)
            {
                sub.Title = _subTitle;
                sub.StartTime = _subStart.Value;
                sub.EndTime = _subEnd.Value;
                sub.Location = _subLocation;
                _logMessage = $"[Succes] Del-begivenheden '{_subTitle}' blev opdateret.";
            }
        }
        else
        {
            // Add new subevent
            var newSub = new Subevent
            {
                Title = _subTitle,
                StartTime = _subStart.Value,
                EndTime = _subEnd.Value,
                Location = _subLocation
            };
            if (_selectedCard.Subevents == null)
            {
                _selectedCard.Subevents = [];
            }
            _selectedCard.Subevents.Add(newSub);
            _logMessage = $"[Succes] Del-begivenheden '{_subTitle}' blev tilføjet til programmet.";
        }

        await PostgresService.SaveEventAsync(_selectedCard);

        var events = await PostgresService.FetchAllEventsAsync();
        _allCards.Clear();
        _allCards.AddRange(events);

        GenerateCalendarGrid();
        CancelEditSubevent();
        StateHasChanged();
    }

    private async Task DeleteSubevent(Subevent sub)
    {
        if (_selectedCard is null) return;

        _selectedCard.Subevents.Remove(sub);
        await PostgresService.SaveEventAsync(_selectedCard);

        var events = await PostgresService.FetchAllEventsAsync();
        _allCards.Clear();
        _allCards.AddRange(events);

        GenerateCalendarGrid();
        _logMessage = $"[System] Del-begivenheden '{sub.Title}' blev fjernet fra programmet.";
        StateHasChanged();
    }

    private void OpenCreateDrawer()
    {
        _newSubject = string.Empty;
        _newDate = DateTime.Today;
        _newStartTime = new TimeSpan(11, 0, 0);
        _newEndTime = new TimeSpan(18, 0, 0);
        _newArea = string.IsNullOrWhiteSpace(_activeLocationFilter) ? "Den Store Lade" : _activeLocationFilter;
        _newSubtype = "Bryllup";
        _newGuestCount = 100;
        _newCatering = "Gourmet Selskabsmenu";
        _newPrice = 0;
        _newCoordinator = "Sarah Jenkins";

        _isCreateDrawerOpen = true;
        StateHasChanged();
    }

    private void OnCellClicked(DateTime date)
    {
        OnCellClicked(date, _activeLocationFilter);
    }

    private void OnCellClicked(DateTime date, string? location)
    {
        _newSubject = string.Empty;
        _newDate = date;
        _newStartTime = new TimeSpan(11, 0, 0);
        _newEndTime = new TimeSpan(18, 0, 0);
        _newArea = string.IsNullOrWhiteSpace(location) ? "Den Store Lade" : location;
        _newSubtype = "Bryllup";
        _newGuestCount = 100;
        _newCatering = "Gourmet Selskabsmenu";
        _newPrice = 0;
        _newCoordinator = "Sarah Jenkins";

        _isCreateDrawerOpen = true;
        StateHasChanged();
    }

    private async Task SaveNewReservation()
    {
        if (string.IsNullOrWhiteSpace(_newSubject))
        {
            _logMessage = _isStaffView 
                ? "[Systemfejl] Selskabsnavn skal udfyldes." 
                : "[Systemfejl] Dit Navn eller selskabsnavn skal udfyldes.";
            return;
        }
        if (!_newDate.HasValue || !_newStartTime.HasValue || !_newEndTime.HasValue)
        {
            _logMessage = "[Systemfejl] Dato og klokkeslæt skal angives.";
            return;
        }

        var localStart = _newDate.Value.Date.Add(_newStartTime.Value);
        var localEnd = _newDate.Value.Date.Add(_newEndTime.Value);
        
        if (localEnd <= localStart)
        {
            _logMessage = "[Systemfejl] Sluttidspunkt skal være efter starttidspunkt.";
            return;
        }

        DateTimeOffset startUtc = new DateTimeOffset(localStart, TimeZoneInfo.Local.GetUtcOffset(localStart));
        DateTimeOffset endUtc = new DateTimeOffset(localEnd, TimeZoneInfo.Local.GetUtcOffset(localEnd));

        var coordinator = _isStaffView ? _newCoordinator : "Sarah Jenkins";
        var subject = _isStaffView ? _newSubject : $"[Forespørgsel] {_newSubject}";
        var body = _isStaffView 
            ? $"Manuelt oprettet reservation. Forplejning: {_newCatering}."
            : $"Kundeforespørgsel modtaget via online kalender. Forplejning: {_newCatering}.";

        var newCard = new KanbanEventCard
        {
            GraphEventId = $"custom-evt-{Guid.NewGuid()}",
            MetadataId = Guid.NewGuid(),
            Subject = subject,
            BodyContent = body,
            ColorHex = GetColorForSubtype(_newSubtype),
            Priority = "Normal",
            SectionKey = _isStaffView ? "confirmed" : "inquiry",
            StartUtc = startUtc,
            EndUtc = endUtc,
            EventSubtype = _newSubtype,
            GuestCount = _newGuestCount,
            AssignedCoordinator = coordinator,
            EstateArea = _newArea,
            CateringOption = _newCatering,
            Price = _newPrice > 0 ? _newPrice : null,
            ActionItems = GetDefaultActionItems(_newSubtype, _newArea, _newGuestCount, _newCatering, coordinator)
        };

        await PostgresService.SaveEventAsync(newCard);

        var events = await PostgresService.FetchAllEventsAsync();
        _allCards.Clear();
        _allCards.AddRange(events);

        GenerateCalendarGrid();

        _isCreateDrawerOpen = false;
        _logMessage = _isStaffView 
            ? $"[Succes] Selskabet '{newCard.Subject}' blev oprettet med succes i {newCard.EstateArea}."
            : $"[Forespørgsel Sendt] Mange tak! Din reservation-forespørgsel til '{_newSubject}' i {newCard.EstateArea} er modtaget. Vi kontakter dig hurtigst muligt!";
        StateHasChanged();
    }

    private string GetColorForSubtype(string subtype)
    {
        return subtype switch
        {
            "Bryllup" => "#9c27b0",
            "Konference" => "#009688",
            "Privat Fest" => "#e91e63",
            "Jagt & Event" => "#ff9800",
            _ => "#607d8b"
        };
    }

    private List<string> GetDefaultActionItems(string subtype, string area, int guests, string catering, string coordinator)
    {
        if (subtype == "Bryllup")
        {
            return
            [
                $"Borddækning i {area} til {guests} gæster med dansegulv",
                $"Koordiner bryllupsmenuen '{catering}' med herregårdskøkkenet",
                $"Koordinator {coordinator} holder briefing med serveringspersonale"
            ];
        }
        else if (subtype == "Konference")
        {
            return
            [
                $"Klargør AV-udstyr, projektor og Wi-Fi i {area}",
                $"Anret {catering} i pauserne til {guests} deltagere",
                $"Koordinator {coordinator} sikrer kaffe- og vandopfyldning under mødet"
            ];
        }
        else
        {
            return
            [
                $"Klargør modtagelse i {area} til {guests} gæster",
                $"Koordiner anretning af {catering}",
                $"Koordinator {coordinator} sikrer klargøring af lydanlæg"
            ];
        }
    }

    private void PreviousMonth()
    {
        _currentDate = _currentDate.AddMonths(-1);
        GenerateCalendarGrid();
    }

    private void NextMonth()
    {
        _currentDate = _currentDate.AddMonths(1);
        GenerateCalendarGrid();
    }

    private async Task DeleteEventAsync(KanbanEventCard? card)
    {
        if (card is null) return;

        bool? confirmed = await DialogService.ShowMessageBox(
            "Slet Selskab",
            $"Vil du slette selskabet '{card.Subject}'? Denne handling kan ikke fortrydes.",
            yesText: "Slet",
            cancelText: "Annuller"
        );

        if (confirmed == true)
        {
            await PostgresService.DeleteEventAsync(card.GraphEventId);
            _isDrawerOpen = false;
            _selectedCard = null;
            _logMessage = $"[Succes] Selskabet '{card.Subject}' blev slettet fra database og kalender.";
            await LoadEventsAsync();
        }
    }

    private void SimulatePdfExport()
    {
        _logMessage = $"[System Hub] Kalender-agenda i PDF-format eksporteret for {_currentDate.ToString("MMMM yyyy", new System.Globalization.CultureInfo("da-DK"))} til 'Estate_Agenda_{_currentDate:MMyyyy}.pdf'.";
    }

    private void SimulateExcelExport()
    {
        _logMessage = $"[System Hub] Excel-ark med gæsteantal og catering-valg hentet til 'Catering_Reservations_{_currentDate:MMyyyy}.xlsx'.";
    }

    private class CalendarDayCell
    {
        public DateTime Date { get; set; }
        public bool IsCurrentMonth { get; set; }
        public List<KanbanEventCard> Cards { get; set; } = [];
    }
}
