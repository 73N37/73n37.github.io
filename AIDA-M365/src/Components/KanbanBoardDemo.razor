    private string CalculateTotalRevenue()
    {
        double revenue = 0;
        foreach (var card in _cards)
        {
            if (card.GraphEventId == "event-fail") continue; // Exclude mock error card
            double basePrice = 12000;
            if (card.EventSubtype == "Wedding" || card.EventSubtype == "Bryllup") basePrice = 35000;
            else if (card.EventSubtype == "Birthday" || card.EventSubtype == "Privat Fest") basePrice = 18000;
            else if (card.EventSubtype == "Conference" || card.EventSubtype == "Konference") basePrice = 15000;
            else if (card.EventSubtype == "Jagt & Event") basePrice = 25000;

            double perGuestPrice = 450;
            if (card.CateringOption == "Fine Dining" || card.CateringOption == "Gourmet Selskabsmenu") perGuestPrice = 1250;
            else if (card.CateringOption == "Buffet & Mocktails" || card.CateringOption == "Konference-dagsmenu") perGuestPrice = 650;
            else if (card.CateringOption == "Champagne Brunch" || card.CateringOption == "Brunch & Champagne") perGuestPrice = 850;

            revenue += basePrice + (card.GuestCount * perGuestPrice);
        }
        return $"{revenue:N0} DKK";
    }

    private Task OpenCreateSectionDialogAsync()
    {
        _newSectionTitle = null;
        _dayOffsetFromToday = 0;
        _startHourUtc = 9;
        _startMinuteUtc = 0;
        
        _showCreateSectionDialog = true;
        return Task.CompletedTask;
    }

    private Task CreateSectionAsync()
    {
        if (string.IsNullOrWhiteSpace(_newSectionTitle))
        {
            return Task.CompletedTask;
        }

        var key = _newSectionTitle.ToLowerInvariant().Replace(" ", "-");
        
        if (_sections.Any(s => s.Key == key))
        {
            key = $"{key}-{DateTime.Now.Ticks}";
        }

        var newSection = new KanbanSectionDefinition
        {
            Key = key,
            Title = _newSectionTitle,
            DayOffsetFromTodayUtc = _dayOffsetFromToday,
            StartHourUtc = _startHourUtc,
            StartMinuteUtc = _startMinuteUtc
        };

        _sections.Add(newSection);
        _lastUpdatedMessage = $"Oprettede ny kolonne: {newSection.Title}";
        _showCreateSectionDialog = false;
        StateHasChanged();

        return Task.CompletedTask;
    }

    private Task OnCardUpdatedAsync(KanbanEventCard card)
    {
        _lastUpdatedMessage =
            $"[Synkronisering] Gen-synkroniserede '{card.Subject}' via MS Graph. Ny tid: {card.StartUtc.ToLocalTime():g} i kolonnen '{card.SectionKey}'.";

        return Task.CompletedTask;
    }

    private Task OnSectionDeletedAsync(KanbanSectionDefinition section)
    {
        var cardsInDeletedSection = _cards.Where(c => c.SectionKey == section.Key).ToList();
        foreach (var card in cardsInDeletedSection)
        {
            _cards.Remove(card);
        }

        _sections.Remove(section);
        _lastUpdatedMessage = $"Slettede kolonnen: {section.Title}";
        StateHasChanged();

        return Task.CompletedTask;
    }
    }
}
