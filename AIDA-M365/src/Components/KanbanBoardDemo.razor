@page "/home"
@implements IDisposable
@using AIDA.M365.Models
@using Microsoft.AspNetCore.Components
@using MudBlazor
@inject AIDA.M365.Services.IPostgresDatabaseService PostgresService
@inject AIDA.M365.Services.IntegrationStateContainer StateContainer

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6" Style="background: transparent;">
    <MudStack Spacing="6">
        
        <!-- Header Command Center Banner with responsive gradient and text styling -->
        <MudPaper Class="pa-6 rounded-lg" Elevation="4" Style="background: linear-gradient(135deg, #070A13 0%, #10B981 100%); color: white; border: 1px solid rgba(255,255,255,0.05);">
            <MudGrid AlignItems="AlignItems.Center">
                <MudItem xs="12" md="8">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h3" Class="brand-text font-weight-bold" Style="letter-spacing: -1px; color: #FAF9F6;">Gods Styringstavle & Afvikling</MudText>
                        <MudText Typo="Typo.subtitle1" Style="color: #E2E8F0; font-weight: 300;">
                            Strategisk selskabsstyring til afvikling af bryllupper, konferencer og private fester på Engestofte Gods.
                        </MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" md="4" Class="d-flex justify-md-end justify-start">
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Secondary" 
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="() => _isCreateDrawerOpen = true"
                                   Style="border-radius: 8px; font-weight: 600; padding: 10px 20px;">
                            Opret Selskab
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- KPI Metrics Grid -->
        <MudGrid>
            <!-- KPI 1: Active Bookings -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 rounded-lg glass-panel" Elevation="2" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Class="text-muted font-weight-bold" Style="letter-spacing: 0.5px;">AKTIVE SELSKABER</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold">@_cards.Count Selskaber</MudText>
                        </MudStack>
                        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium" Style="border-radius: 8px;">
                            <MudIcon Icon="@Icons.Material.Filled.Event" />
                        </MudAvatar>
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Success" Class="d-flex align-center mt-2 font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Class="mr-1" />
                        +1 Forespørgsel Afventer
                    </MudText>
                </MudPaper>
            </MudItem>

            <!-- KPI 2: Estimated Revenue -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 rounded-lg glass-panel" Elevation="2" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Class="text-muted font-weight-bold" Style="letter-spacing: 0.5px;">FORVENTET OMSÆTNING</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold text-success">@CalculateTotalRevenue()</MudText>
                        </MudStack>
                        <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Medium" Style="border-radius: 8px;">
                            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" />
                        </MudAvatar>
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="text-muted d-flex align-center mt-2">
                        Baseret på gæstepakker & forplejning
                    </MudText>
                </MudPaper>
            </MudItem>

            <!-- KPI 3: Total Guests -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 rounded-lg glass-panel" Elevation="2" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Class="text-muted font-weight-bold" Style="letter-spacing: 0.5px;">FORVENTEDE GÆSTER I ALT</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold">@_cards.Sum(c => c.GuestCount) Gæster</MudText>
                        </MudStack>
                        <MudAvatar Color="Color.Info" Variant="Variant.Filled" Size="Size.Medium" Style="border-radius: 8px;">
                            <MudIcon Icon="@Icons.Material.Filled.People" />
                        </MudAvatar>
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="text-muted d-flex align-center mt-2">
                        Belægning for lade & hovedbygning
                    </MudText>
                </MudPaper>
            </MudItem>

            <!-- KPI 4: Synchronisation Hub -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 rounded-lg glass-panel" Elevation="2" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Class="text-muted font-weight-bold" Style="letter-spacing: 0.5px;">INTEGRATIONSBROER</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold text-success">FORBUNDET</MudText>
                        </MudStack>
                        <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Medium" Style="border-radius: 8px;">
                            <MudIcon Icon="@Icons.Material.Filled.CloudQueue" />
                        </MudAvatar>
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Success" Class="d-flex align-center mt-2 font-weight-bold">
                        <span class="pulse-indicator mr-2"></span>
                        Graph & Gods synkronisering aktiv
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Main Alert Zone -->
        @if (!string.IsNullOrWhiteSpace(_lastUpdatedMessage))
        {
            <MudAlert Severity="Severity.Success" Dense="true" Variant="Variant.Filled" Elevation="2" Style="border-radius: 8px; font-weight: 500;">
                @_lastUpdatedMessage
            </MudAlert>
        }

        <!-- Kanban Board Component -->
        <KanbanBoard Sections="_sections" Cards="_cards" CardUpdated="OnCardUpdatedAsync" SectionDeleted="OnSectionDeletedAsync" CardDeleted="OnCardDeletedAsync" />
    </MudStack>
</MudContainer>

<MudDialog @bind-IsVisible="_showCreateSectionDialog" Options="new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small }">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold">Opret Nyt Selskabsstadie</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_newSectionTitle"
                          Label="Titel"
                          Placeholder="f.eks. Reserveret, Depositum Betalt"
                          FullWidth="true"
                          Variant="Variant.Outlined" />
            
            <MudNumericField @bind-Value="_dayOffsetFromToday"
                             Label="Dato Offset (0 = i dag, 1 = i morgen)"
                             Min="-7"
                             Max="7"
                             FullWidth="true"
                             Variant="Variant.Outlined" />
            
            <MudNumericField @bind-Value="_startHourUtc"
                             Label="Starttime (UTC 0-23)"
                             Min="0"
                             Max="23"
                             FullWidth="true"
                             Variant="Variant.Outlined" />
            
            <MudNumericField @bind-Value="_startMinuteUtc"
                             Label="Startminut (0-59)"
                             Min="0"
                             Max="59"
                             FullWidth="true"
                             Variant="Variant.Outlined" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showCreateSectionDialog = false" Style="border-radius: 8px;">Annuller</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateSectionAsync" Style="border-radius: 8px; font-weight: bold;">Opret</MudButton>
    </DialogActions>
</MudDialog>

<!-- Opret Selskab Modal (Delt med Kalenderen) -->
@if (_isCreateDrawerOpen)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 1300;" @onclick="() => _isCreateDrawerOpen = false"></div>
    <MudPaper Elevation="8" Style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1301; width: 480px; max-width: calc(100vw - 32px); max-height: 90vh; overflow-y: auto; border-radius: 12px; background-color: #FAF9F6; font-family: 'Inter', sans-serif;">
        <MudStack Class="pa-6" Spacing="4">
            <MudStack Row="true" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: #2C3E50;">
                    @(_isStaffView ? "Opret Selskab" : "Send Forespørgsel om Reservation")
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="() => _isCreateDrawerOpen = false" />
            </MudStack>
            <MudDivider />

            <MudTextField @bind-Value="_newSubject"
                          Label="@(_isStaffView ? "Selskabsnavn / Emne" : "Dit Navn / Selskabsnavn")"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Required="true" />

            <MudDatePicker @bind-Date="_newDate"
                           Label="Dato"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Required="true"
                           PickerVariant="PickerVariant.Static"
                           Style="background-color: white; border-radius: 8px;" />

            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudTimePicker @bind-Time="_newStartTime" Label="Starttidspunkt" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                </MudItem>
                <MudItem xs="6">
                    <MudTimePicker @bind-Time="_newEndTime" Label="Sluttidspunkt" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                </MudItem>
            </MudGrid>

            <MudSelect @bind-Value="_newArea" Label="Lokation på Engestofte Gods" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("Den Store Lade")">Den Store Lade</MudSelectItem>
                <MudSelectItem Value="@("Hovedbygningen")">Hovedbygningen</MudSelectItem>
                <MudSelectItem Value="@("Søparken")">Søparken</MudSelectItem>
            </MudSelect>

            <MudSelect @bind-Value="_newSubtype" Label="Kategori" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("Bryllup")">Bryllup</MudSelectItem>
                <MudSelectItem Value="@("Konference")">Konference</MudSelectItem>
                <MudSelectItem Value="@("Privat Fest")">Privat Fest</MudSelectItem>
                <MudSelectItem Value="@("Jagt & Event")">Jagt & Event</MudSelectItem>
            </MudSelect>

            <MudNumericField @bind-Value="_newGuestCount" Label="Antal Gæster" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" />

            <MudSelect @bind-Value="_newCatering" Label="Forplejning" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("Gourmet Selskabsmenu")">Gourmet Selskabsmenu</MudSelectItem>
                <MudSelectItem Value="@("Konference-dagsmenu")">Konference-dagsmenu</MudSelectItem>
                <MudSelectItem Value="@("Brunch & Champagne")">Brunch & Champagne</MudSelectItem>
            </MudSelect>

            <MudNumericField @bind-Value="_newPrice"
                             Label="Pris (DKK)"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="0"
                             Format="N0"
                             Adornment="Adornment.End"
                             AdornmentText="kr."
                             HideSpinButtons="true" />

            @if (_isStaffView)
            {
                <MudTextField @bind-Value="_newCoordinator" Label="Ansvarlig Koordinator" Variant="Variant.Outlined" Margin="Margin.Dense" />
            }

            <MudStack Row="true" Spacing="2" JustifyContent="JustifyContent.FlexEnd">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="() => _isCreateDrawerOpen = false" Style="border-radius: 8px;">
                    Annuller
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveNewReservation" Style="background-color: #2C3E50; color: white; border-radius: 8px; font-weight: bold;">
                    @(_isStaffView ? "Gem Selskab" : "Send Forespørgselsmail")
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
}

<style>
    .pulse-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: var(--mud-palette-success);
        box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.7);
        animation: pulse 1.5s infinite;
        display: inline-block;
    }

    @@keyframes pulse {
        0% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.7);
        }
        70% {
            transform: scale(1);
            box-shadow: 0 0 0 6px rgba(76, 175, 80, 0);
        }
        100% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(76, 175, 80, 0);
        }
    }
</style>

@code {
    private readonly List<KanbanSectionDefinition> _sections =
    [
        new()
        {
            Key = "inquiry",
            Title = "Henvendelser",
            DayOffsetFromTodayUtc = 2,
            StartHourUtc = 9,
            StartMinuteUtc = 0
        },
        new()
        {
            Key = "quoted",
            Title = "Sendte Tilbud",
            DayOffsetFromTodayUtc = 1,
            StartHourUtc = 10,
            StartMinuteUtc = 0
        },
        new()
        {
            Key = "confirmed",
            Title = "Bekræftede Bookinger",
            DayOffsetFromTodayUtc = 0,
            StartHourUtc = 11,
            StartMinuteUtc = 0
        },
        new()
        {
            Key = "preparation",
            Title = "Planlægning",
            DayOffsetFromTodayUtc = 0,
            StartHourUtc = 8,
            StartMinuteUtc = 0
        },
        new()
        {
            Key = "active",
            Title = "Afvikling",
            DayOffsetFromTodayUtc = 0,
            StartHourUtc = 14,
            StartMinuteUtc = 0
        },
        new()
        {
            Key = "completed",
            Title = "Afsluttet",
            DayOffsetFromTodayUtc = 0,
            StartHourUtc = 18,
            StartMinuteUtc = 0
        }
    ];

    private readonly List<KanbanEventCard> _cards = [];

    private string? _lastUpdatedMessage;

    // Dialog state for creating new sections
    private bool _showCreateSectionDialog;
    private string? _newSectionTitle;
    private int _dayOffsetFromToday;
    private int _startHourUtc;
    private int _startMinuteUtc;

    // Opret Selskab Form State variables
    private bool _isCreateDrawerOpen;
    private bool _isStaffView = true;
    
    private string _newSubject = string.Empty;
    private DateTime? _newDate = DateTime.Today;
    private TimeSpan? _newStartTime = new TimeSpan(11, 0, 0);
    private TimeSpan? _newEndTime = new TimeSpan(18, 0, 0);
    private string _newArea = "Den Store Lade";
    private string _newSubtype = "Bryllup";
    private int _newGuestCount = 50;
    private string _newCatering = "Gourmet Selskabsmenu";
    private decimal _newPrice = 0;
    private string _newCoordinator = "Sarah Jenkins";

    protected override async Task OnInitializedAsync()
    {
        StateContainer.OnChange += OnStateChanged;
        await LoadEventsAsync();
    }

    private async Task LoadEventsAsync()
    {
        var events = await PostgresService.FetchAllEventsAsync();
        _cards.Clear();
        _cards.AddRange(events);
        StateHasChanged();
    }

    private async void OnStateChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadEventsAsync();
        });
    }

    public void Dispose()
    {
        StateContainer.OnChange -= OnStateChanged;
    }

    private string CalculateTotalRevenue()
    {
        double revenue = 0;
        foreach (var card in _cards)
        {
            if (card.GraphEventId == "event-fail") continue; // Exclude mock error card

            if (card.Price.HasValue)
            {
                revenue += (double)card.Price.Value;
            }
            else
            {
                double basePrice = 12000;
                if (card.EventSubtype == "Wedding" || card.EventSubtype == "Bryllup") basePrice = 35000;
                else if (card.EventSubtype == "Birthday" || card.EventSubtype == "Privat Fest") basePrice = 18000;
                else if (card.EventSubtype == "Conference" || card.EventSubtype == "Konference") basePrice = 15000;
                else if (card.EventSubtype == "Jagt & Event") basePrice = 25000;

                double perGuestPrice = 450;
                if (card.CateringOption == "Fine Dining" || card.CateringOption == "Gourmet Selskabsmenu") perGuestPrice = 1250;
                else if (card.CateringOption == "Buffet & Mocktails" || card.CateringOption == "Konference-dagsmenu") perGuestPrice = 650;
                else if (card.CateringOption == "Champagne Brunch" || card.CateringOption == "Brunch & Champagne") perGuestPrice = 850;

                revenue += basePrice + (card.GuestCount * perGuestPrice);
            }
        }
        return $"{revenue:N0} DKK";
    }

    private Task OpenCreateSectionDialogAsync()
    {
        _newSectionTitle = null;
        _dayOffsetFromToday = 0;
        _startHourUtc = 9;
        _startMinuteUtc = 0;
        
        _showCreateSectionDialog = true;
        return Task.CompletedTask;
    }

    private Task CreateSectionAsync()
    {
        if (string.IsNullOrWhiteSpace(_newSectionTitle))
        {
            return Task.CompletedTask;
        }

        var key = _newSectionTitle.ToLowerInvariant().Replace(" ", "-");
        
        if (_sections.Any(s => s.Key == key))
        {
            key = $"{key}-{DateTime.Now.Ticks}";
        }

        var newSection = new KanbanSectionDefinition
        {
            Key = key,
            Title = _newSectionTitle,
            DayOffsetFromTodayUtc = _dayOffsetFromToday,
            StartHourUtc = _startHourUtc,
            StartMinuteUtc = _startMinuteUtc
        };

        _sections.Add(newSection);
        _lastUpdatedMessage = $"Oprettede ny kolonne: {newSection.Title}";
        _showCreateSectionDialog = false;
        StateHasChanged();

        return Task.CompletedTask;
    }

    private async Task OnCardUpdatedAsync(KanbanEventCard card)
    {
        await PostgresService.SaveEventAsync(card);

        var events = await PostgresService.FetchAllEventsAsync();
        _cards.Clear();
        _cards.AddRange(events);

        _lastUpdatedMessage =
            $"[Synkronisering] Gen-synkroniserede '{card.Subject}' via MS Graph. Ny tid: {card.StartUtc.ToLocalTime():g} i kolonnen '{card.SectionKey}'.";

        StateHasChanged();
    }

    private async Task OnSectionDeletedAsync(KanbanSectionDefinition section)
    {
        var cardsInDeletedSection = _cards.Where(c => c.SectionKey == section.Key).ToList();
        foreach (var card in cardsInDeletedSection)
        {
            await PostgresService.DeleteEventAsync(card.GraphEventId);
        }

        var events = await PostgresService.FetchAllEventsAsync();
        _cards.Clear();
        _cards.AddRange(events);

        _sections.Remove(section);
        _lastUpdatedMessage = $"Slettede kolonnen: {section.Title}";
        StateHasChanged();
    }

    private async Task OnCardDeletedAsync(KanbanEventCard card)
    {
        await PostgresService.DeleteEventAsync(card.GraphEventId);

        var events = await PostgresService.FetchAllEventsAsync();
        _cards.Clear();
        _cards.AddRange(events);

        _lastUpdatedMessage = $"[System] Selskabet '{card.Subject}' blev slettet permanent.";
        StateHasChanged();
    }

    private async Task SaveNewReservation()
    {
        if (string.IsNullOrWhiteSpace(_newSubject))
        {
            _lastUpdatedMessage = "[Systemfejl] Selskabsnavn skal udfyldes.";
            return;
        }

        if (!_newDate.HasValue || !_newStartTime.HasValue || !_newEndTime.HasValue)
        {
            _lastUpdatedMessage = "[Systemfejl] Dato, starttid og sluttid skal angives.";
            return;
        }

        var startDateTime = _newDate.Value.Add(_newStartTime.Value);
        var endDateTime = _newDate.Value.Add(_newEndTime.Value);

        if (endDateTime <= startDateTime)
        {
            _lastUpdatedMessage = "[Systemfejl] Sluttidspunkt skal være efter starttidspunkt.";
            return;
        }

        string targetSection = _isStaffView ? "confirmed" : "inquiry";
        string targetPriority = "Normal";
        string targetColor = "#10B981"; // default emerald
        
        if (string.Equals(_newSubtype, "Bryllup", StringComparison.OrdinalIgnoreCase))
        {
            targetColor = "#D4AF37"; // gold
            targetPriority = "High";
        }
        else if (string.Equals(_newSubtype, "Jagt & Event", StringComparison.OrdinalIgnoreCase))
        {
            targetColor = "#EF4444"; // red
            targetPriority = "High";
        }

        var newCard = new KanbanEventCard
        {
            GraphEventId = $"evt-{Guid.NewGuid()}",
            MetadataId = Guid.NewGuid(),
            Subject = _newSubject,
            BodyContent = $"Nyt selskab oprettet direkte fra Godstavlen. Område: {_newArea}, Forplejning: {_newCatering}.",
            ColorHex = targetColor,
            Priority = targetPriority,
            SectionKey = targetSection,
            StartUtc = startDateTime,
            EndUtc = endDateTime,
            EventSubtype = _newSubtype,
            GuestCount = _newGuestCount,
            AssignedCoordinator = _isStaffView ? _newCoordinator : "Afventer godkendelse",
            EstateArea = _newArea,
            CateringOption = _newCatering,
            Price = _newPrice > 0 ? _newPrice : null
        };

        await PostgresService.SaveEventAsync(newCard);

        var events = await PostgresService.FetchAllEventsAsync();
        _cards.Clear();
        _cards.AddRange(events);

        _isCreateDrawerOpen = false;
        
        // Reset form
        _newSubject = string.Empty;
        _newDate = DateTime.Today;
        _newStartTime = new TimeSpan(11, 0, 0);
        _newEndTime = new TimeSpan(18, 0, 0);
        _newArea = "Den Store Lade";
        _newSubtype = "Bryllup";
        _newGuestCount = 50;
        _newCatering = "Gourmet Selskabsmenu";
        _newPrice = 0;
        _newCoordinator = "Sarah Jenkins";

        _lastUpdatedMessage = _isStaffView 
            ? $"[Succes] Selskabet '{newCard.Subject}' blev oprettet og lagt i kolonnen '{newCard.SectionKey}'."
            : $"[Succes] Forespørgsel om '{newCard.Subject}' blev indsendt til godkendelse.";
            
        StateHasChanged();
    }
    }
}
