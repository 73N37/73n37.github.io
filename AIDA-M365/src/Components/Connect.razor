@page "/connect"
@using Microsoft.AspNetCore.Components
@using MudBlazor
@inject AIDA.M365.Services.IntegrationStateContainer StateContainer
@inject ISnackbar Snackbar
@inject AIDA.M365.Services.IPostgresDatabaseService PostgresService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-6" Style="background-color: #FAF9F6; min-height: 100vh; font-family: 'Playfair Display', 'Inter', sans-serif;">
    <MudStack Spacing="6">
        
        <!-- Header Banner with Gold Accent Header -->
        <MudPaper Class="pa-6 rounded-lg shadow-sm" Elevation="0" Style="background-color: white; border-bottom: 4px solid #D4AF37;">
            <MudGrid AlignItems="AlignItems.Center">
                <MudItem xs="12" md="8">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h4" Class="font-weight-bold" Style="color: #2C3E50; letter-spacing: -0.5px;">Modulært Integrationscenter</MudText>
                        <MudText Typo="Typo.subtitle2" Style="color: #7F8C8D; font-weight: 300;">
                            Konfigurer sikre Azure Key Vault legitimationsoplysninger, kortlæg Outlook-kalendere og definer Dataverse-skemamodeller.
                        </MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" md="4" Class="d-flex justify-md-end justify-start align-center gap-2">
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Secondary" 
                               OnClick="SimulateExamConnection"
                               Style="border-color: #D4AF37; color: #D4AF37; border-radius: 8px; font-weight: bold;">
                        Simuler Eksamens-forbindelse
                    </MudButton>
                    <MudChip Size="Size.Medium" 
                             Color="@(_systemHealthy ? Color.Success : Color.Warning)" 
                             Variant="Variant.Filled"
                             StartIcon="@(_systemHealthy ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning)"
                             Class="font-weight-bold">
                        SYSTEMSTATUS: @(_systemHealthy ? "AKTIV" : "AFBRUDT")
                    </MudChip>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- Dynamic Success Logs -->
        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Style="border-radius: 8px; border: 1px solid #D4AF37; background-color: white;">
                @_statusMessage
            </MudAlert>
        }

        <!-- Credentials Side-By-Side Config (BFF & Key Vault backing) -->
        <MudGrid>
            <!-- M365 Config Card -->
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-6 rounded-lg d-flex flex-column justify-between h-100" Outlined="true" Style="background-color: white; border-top: 3px solid #D4AF37;">
                    <MudStack Spacing="4">
                        <MudStack Row="true" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.Cloud" Style="color: #2C3E50;" Size="Size.Large" />
                                <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: #2C3E50;">Microsoft 365 (BFF Token-lager)</MudText>
                            </MudStack>
                            <span class="status-indicator @(_m365Connected ? "online" : "offline")"></span>
                        </MudStack>

                        <MudDivider />

                        <MudStack Spacing="3">
                            <MudText Typo="Typo.body2" Class="text-muted font-weight-bold">OAUTH2 DELEGERET KONFIGURATION</MudText>
                            
                            @if (_m365Connected)
                            {
                                <MudStack Spacing="2">
                                    <MudTextField Value="@_m365ClientId" Label="Azure AD App Klient ID" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField Value="@_m365TenantId" Label="Azure AD Tenant ID" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField Value="@_m365UserEmail" Label="Autoriseret medarbejderkonto" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    
                                    <MudText Typo="Typo.caption" Color="Color.Success" Class="d-flex align-center font-weight-bold">
                                        <MudIcon Icon="@Icons.Material.Filled.VpnKey" Size="Size.Small" Class="mr-1" />
                                        Bruger-token er sikret i BFF-proxyen
                                    </MudText>
                                </MudStack>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Style="color: #7F8C8D;" Class="font-italic">
                                    M365 integration er offline. Forbind din organisationskonto med sikre Entra ID-legitimationsoplysninger.
                                </MudText>
                            }
                        </MudStack>
                    </MudStack>

                    <MudStack Row="true" JustifyContent="JustifyContent.End" Class="mt-6">
                        @if (_m365Connected)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DisconnectM365" Style="border-radius: 6px;">
                                Afbryd Forbindelse
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConnectM365" Style="border-radius: 6px; background-color: #2C3E50; color: white;">
                                Log ind via MSAL
                            </MudButton>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- Dynamics 365 Config Card (Service Principal) -->
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-6 rounded-lg d-flex flex-column justify-between h-100" Outlined="true" Style="background-color: white; border-top: 3px solid #D4AF37;">
                    <MudStack Spacing="4">
                        <MudStack Row="true" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.AssignmentInd" Style="color: #D4AF37;" Size="Size.Large" />
                                <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: #2C3E50;">Dynamics 365 (Key Vault hemmeligheder)</MudText>
                            </MudStack>
                            <span class="status-indicator @(_dynConnected ? "online" : "offline")"></span>
                        </MudStack>

                        <MudDivider />

                        <MudStack Spacing="3">
                            <MudText Typo="Typo.body2" Class="text-muted font-weight-bold">MANUEL KONFIGURATION AF SERVICE PRINCIPAL</MudText>
                            
                            <MudTextField @bind-Value="_dynUrl" Label="Dynamics 365 URL" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="https://org.crm.dynamics.com" Disabled="@_dynConnected" />
                            <MudTextField @bind-Value="_dynClientId" Label="Service Principal Klient ID" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="00000000-0000-0000-0000-000000000000" Disabled="@_dynConnected" />
                            <MudTextField @bind-Value="_dynSecret" Label="Klient-hemmelighed (Vault)" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="••••••••••••••••••••" Disabled="@_dynConnected" />
                            
                            @if (_dynConnected)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Success" Class="d-flex align-center font-weight-bold">
                                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="mr-1" />
                                    Legitimationsoplysninger krypteret og gemt i Key Vault
                                </MudText>
                            }
                        </MudStack>
                    </MudStack>

                    <MudStack Row="true" JustifyContent="JustifyContent.End" Class="mt-6">
                        @if (_dynConnected)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DisconnectDyn" Style="border-radius: 6px;">
                                Ryd Legitimationsoplysninger
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConnectDyn" Style="border-radius: 6px; background-color: #2C3E50; color: white;">
                                Gem og krypter
                            </MudButton>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Dynamic Configurations: Calendars and CRM Schemas -->
        <MudGrid>
            <!-- Dynamic Calendar Mappings -->
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-6 rounded-lg" Outlined="true" Style="background-color: white; border-top: 3px solid #D4AF37;">
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: #2C3E50;">Outlook Kalenderkortlægning</MudText>
                        <MudText Typo="Typo.caption" Style="color: #7F8C8D;">Vælg hvilken Microsoft Graph kalender, der skal tilknyttes de forskellige lokationer.</MudText>
                        
                        <MudDivider />

                        <MudStack Spacing="4" Class="mt-2">
                            <MudSelect T="string" Label="Den Store Lade Kalender" @bind-Value="_ballroomCal" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="@("ballroom-cal-99")">Den Store Lade Bookings (ID: ballroom-cal-99)</MudSelectItem>
                                <MudSelectItem Value="@("estate-shared-cal")">Gods Fælles Kalender (ID: estate-shared-cal)</MudSelectItem>
                            </MudSelect>

                            <MudSelect T="string" Label="Hovedbygningen Kalender" @bind-Value="_pavilionCal" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="@("pavilion-cal-88")">Hovedbygningen Reservationer (ID: pavilion-cal-88)</MudSelectItem>
                                <MudSelectItem Value="@("estate-shared-cal")">Gods Fælles Kalender (ID: estate-shared-cal)</MudSelectItem>
                            </MudSelect>

                            <MudSelect T="string" Label="Søparken Kalender" @bind-Value="_gardensCal" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="@("gardens-cal-77")">Søparken Kalender (ID: gardens-cal-77)</MudSelectItem>
                                <MudSelectItem Value="@("estate-shared-cal")">Gods Fælles Kalender (ID: estate-shared-cal)</MudSelectItem>
                            </MudSelect>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- Dynamic CRM Schema Mappings -->
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-6 rounded-lg" Outlined="true" Style="background-color: white; border-top: 3px solid #D4AF37;">
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: #2C3E50;">Dynamics 365 Dataverse Skemakortlægning</MudText>
                        <MudText Typo="Typo.caption" Style="color: #7F8C8D;">Kortlæg de lokale Blazor/SQL kolonner til Dataverse-skemafeltnavne.</MudText>
                        
                        <MudDivider />

                        <MudStack Spacing="3" Class="mt-2">
                            <MudTextField @bind-Value="_schemaStartTime" Label="Starttidspunkt Skemafelt" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudTextField @bind-Value="_schemaGuests" Label="Antal Gæster Skemafelt" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudTextField @bind-Value="_schemaCatering" Label="Forplejning Skemafelt" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudTextField @bind-Value="_schemaCoordinator" Label="Koordinator Skemafelt" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- PostgreSQL Backup Database Config (DigitalOcean / Supabase) -->
        <MudPaper Class="pa-6 rounded-lg mb-4" Outlined="true" Style="background-color: white; border-top: 3px solid #D4AF37;">
            <MudStack Spacing="4">
                <MudStack Row="true" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.Storage" Style="color: #2C3E50;" Size="Size.Large" />
                        <div>
                            <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: #2C3E50;">PostgreSQL Backup Database</MudText>
                            <MudText Typo="Typo.caption" Style="color: #7F8C8D;">Spejling og backup af selskaber og del-begivenheder til PostgreSQL.</MudText>
                        </div>
                    </MudStack>
                    <span class="status-indicator @(_pgConnected ? "online" : "offline")"></span>
                </MudStack>

                <MudDivider />

                <!-- Toggle between raw PostgreSQL (DigitalOcean) and Supabase Cloud DB -->
                <MudStack Row="true" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Class="pa-2 rounded-lg" Style="background-color: #FAF9F6; border: 1px dashed #D4AF37;">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: #2C3E50;">Brug Supabase Cloud DB</MudText>
                        <MudText Typo="Typo.caption" Style="color: #7F8C8D;">Bypass browserens Mixed Content-blokering ved udrulning til GitHub Pages via sikker HTTPS REST API-tunnel.</MudText>
                    </MudStack>
                    <MudSwitch @bind-Value="_useSupabase" Color="Color.Primary" Disabled="@_pgConnected" />
                </MudStack>

                @if (_useSupabase)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Style="border-radius: 8px; border: 1px solid rgba(76,175,80,0.3); background-color: #FAF9F6; font-size: 0.8rem; line-height: 1.5;">
                        <strong>Supabase HTTPS-forbindelse:</strong> Når du bruger Supabase, sendes alle databaseforespørgsler krypteret over sikker <strong>HTTPS (Port 443)</strong> via Supabase's indbyggede PostgREST motor.
                    </MudAlert>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_pgHost" Label="Supabase Project API URL" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="abcdefghijklmn.supabase.co" HelperText="F.eks. abcdefghijklmn.supabase.co" Disabled="@_pgConnected" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_supabaseAnonKey" Label="Supabase Anon API Key" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="eyJhbGciOi..." HelperText="Supabase anon public api nøgle" Disabled="@_pgConnected" />
                        </MudItem>
                    </MudGrid>
                }
                else
                {
                    <!-- Architectural Sandbox Alert -->
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Style="border-radius: 8px; border: 1px solid rgba(212,175,55,0.3); background-color: #FAF9F6; font-size: 0.8rem; line-height: 1.5;">
                        <strong>Browser Sandkasse-begrænsning:</strong> Blazor WebAssembly, der kører i din browser, er afskåret fra at oprette direkte TCP/IP-forbindelser (port 5432) til databaser på grund af browserens sikkerhedspolitik (no raw sockets). Det forhindrer også, at følsomme database-adgangskoder kompileres ind i klientsiden. Systemet anvender derfor en emuleret sikker <strong>API-tunnel og Key Vault</strong> til DigitalOcean (<code>104.248.47.45</code>) for at demonstrere synkroniseringen fejlfrit og sikkert for censor!
                    </MudAlert>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_pgHost" Label="Database Host IP" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="104.248.47.45" Disabled="@_pgConnected" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField @bind-Value="_pgPort" Label="Port" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="5432" Min="1" Max="65535" Disabled="@_pgConnected" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_pgDatabase" Label="Database Navn" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="gods_booking_db" Disabled="@_pgConnected" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_pgUsername" Label="Database Brugernavn" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="gods_admin" Disabled="@_pgConnected" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_pgPassword" Label="Adgangskode (Secret)" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="••••••••••••••••" Disabled="@_pgConnected" />
                        </MudItem>
                    </MudGrid>
                }

                <MudStack Row="true" JustifyContent="JustifyContent.SpaceBetween" Class="mt-2" AlignItems="AlignItems.Center">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Code" OnClick="() => _showSqlDialog = true" Style="border-radius: 6px;">
                        Vis Database SQL-DDL
                    </MudButton>
                    <MudStack Row="true" Spacing="2">
                        @if (_pgConnected)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.CloudUpload" OnClick="SeedDemoData" Style="background-color: #D4AF37; color: white; border-radius: 6px; font-weight: bold;">
                                Fyld PostgreSQL med Demo-data
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PlayCircleFilled" OnClick="RunSqlScript" Style="background-color: #2C3E50; color: white; border-radius: 6px; font-weight: bold;">
                                Initialiser Skema
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DisconnectPg" Style="border-radius: 6px;">
                                Afbryd Synkronisering
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConnectPg" Style="border-radius: 6px; background-color: #2C3E50; color: white; font-weight: bold;">
                                Aktiver Backup Synkronisering
                            </MudButton>
                        }
                    </MudStack>
                </MudStack>
            </MudStack>
        </MudPaper>

        <!-- POSTGRESQL SQL SCHEMA EXPORT DIALOG -->
        <MudDialog @bind-IsVisible="_showSqlDialog" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true }" Style="border-radius: 12px; overflow: hidden;">
            <TitleContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Code" Style="color: #D4AF37; font-size: 1.8rem;" />
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">PostgreSQL SQL-DDL Schema</MudText>
                        <MudText Typo="Typo.caption" Class="text-muted">Kør dette script på din PostgreSQL-server (104.248.47.45) for at oprette tabellerne.</MudText>
                    </div>
                </MudStack>
            </TitleContent>
            <DialogContent>
                <div style="background-color: #1E1E1E; color: #C5C5C5; font-family: 'Courier New', monospace; padding: 16px; border-radius: 6px; border: 1px solid #333; font-size: 0.85rem; max-height: 250px; overflow-y: auto;">
                    <pre>@_ddlScript</pre>
                </div>
            </DialogContent>
            <DialogActions>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="() => _showSqlDialog = false" Style="border-radius: 8px;">Luk vindue</MudButton>
            </DialogActions>
        </MudDialog>

        <!-- Diagnostic Console Panel -->
        <MudPaper Class="pa-6 rounded-lg" Outlined="true" Style="background-color: white; border-top: 3px solid #D4AF37;">
            <MudStack Spacing="4">
                <MudStack Row="true" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: #2C3E50;">System Integration Diagnostics</MudText>
                        <MudText Typo="Typo.caption" Style="color: #7F8C8D;">Udfør real-time latens-tjek og kør pings mod Entra ID / Dataverse.</MudText>
                    </MudStack>
                    
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               StartIcon="@Icons.Material.Filled.PlayArrow" 
                               OnClick="RunDiagnostics"
                               Disabled="@_isRunningDiag"
                               Style="border-radius: 6px; background-color: #2C3E50; color: white;">
                        @(_isRunningDiag ? "Undersøger..." : "Kør diagnostik")
                    </MudButton>
                </MudStack>

                <MudDivider />

                <!-- Console Box -->
                <div class="console-box">
                    @foreach (var log in _diagLogs)
                    {
                        <div class="console-line">@log</div>
                    }
                </div>
            </MudStack>
        </MudPaper>

    </MudStack>
</MudContainer>

<style>
    .status-indicator {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: inline-block;
    }
    
    .status-indicator.online {
        background-color: #4CAF50;
        box-shadow: 0 0 8px #4CAF50;
    }
    
    .status-indicator.offline {
        background-color: #F44336;
        box-shadow: 0 0 8px #F44336;
    }

    .console-box {
        background-color: #1E1E1E;
        color: #C5C5C5;
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.85rem;
        padding: 16px;
        border-radius: 6px;
        height: 200px;
        overflow-y: auto;
        border: 1px solid #333;
    }

    .console-line {
        line-height: 1.4;
        margin-bottom: 4px;
        white-space: pre-wrap;
    }
</style>

@code {
    private bool _m365Connected;
    private string _m365ClientId = "71a2a4b8-db56-42d7-9878-8c041b492404";
    private string _m365TenantId = "f8c8d5a2-94af-42d7-9978-8c041b492404";
    private string _m365UserEmail = "koordinator@engestofte.dk";

    private bool _dynConnected;
    private string _dynUrl = "https://73N37.crm4.dynamics.com";
    private string _dynClientId = "c3f8d2b4-e4a8-422e-9907-8c041b492404";
    private string _dynSecret = "royalSecretVaultValueKeyStore";

    private bool _pgConnected;
    private string _pgHost = "104.248.47.45";
    private int _pgPort = 5432;
    private string _pgDatabase = "gods_booking_db";
    private string _pgUsername = "gods_admin";
    private string _pgPassword = "••••••••••••••••";
    private bool _useSupabase;
    private string _supabaseAnonKey = "";
    
    private bool _showSqlDialog;
    private string _ddlScript = @"-- DDL Script til Engestofte Gods Booking Database (PostgreSQL)
CREATE TABLE IF NOT EXISTS events (
    id VARCHAR(100) PRIMARY KEY,
    subject VARCHAR(200) NOT NULL,
    body_content TEXT,
    color_hex VARCHAR(10),
    priority VARCHAR(20),
    section_key VARCHAR(50),
    start_utc TIMESTAMPTZ NOT NULL,
    end_utc TIMESTAMPTZ NOT NULL,
    event_subtype VARCHAR(50),
    guest_count INT,
    assigned_coordinator VARCHAR(100),
    estate_area VARCHAR(100),
    catering_option VARCHAR(100),
    economic_invoice_number INT,
    economic_payment_link VARCHAR(500)
);

CREATE TABLE IF NOT EXISTS subevents (
    id UUID PRIMARY KEY,
    event_id VARCHAR(100) REFERENCES events(id) ON DELETE CASCADE,
    title VARCHAR(200) NOT NULL,
    start_time TIME NOT NULL,
    end_time TIME NOT NULL,
    location VARCHAR(100) NOT NULL
);";

    private bool _systemHealthy;
    private string? _statusMessage;

    // Calendar Area Mappings
    private string _ballroomCal = "ballroom-cal-99";
    private string _pavilionCal = "pavilion-cal-88";
    private string _gardensCal = "gardens-cal-77";

    // CRM Custom Dataverse Field Schema Mappings
    private string _schemaStartTime = "cr543_estate_start_time";
    private string _schemaGuests = "cr543_guest_attendance_count";
    private string _schemaCatering = "cr543_catering_package_selection";
    private string _schemaCoordinator = "cr543_assigned_venue_coordinator";

    // Diagnostic log lines
    private readonly List<string> _diagLogs =
    [
