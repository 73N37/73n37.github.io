    private void ConnectDyn()
    {
        if (string.IsNullOrWhiteSpace(_dynUrl) || string.IsNullOrWhiteSpace(_dynClientId) || string.IsNullOrWhiteSpace(_dynSecret))
        {
            _statusMessage = "[CRM Link] Alle Service Principal felter (URL, Klient ID, Klient Secret) skal udfyldes.";
            return;
        }

        _dynConnected = true;
        StateContainer.IsDynamicsConnected = true;
        _statusMessage = "[CRM Link] Legitimationsoplysninger gemt. Krypteret Service Principal sendt til Azure Key Vault.";
        UpdateSystemHealth();
    }

    private void DisconnectDyn()
    {
        _dynConnected = false;
        StateContainer.IsDynamicsConnected = false;
        _statusMessage = "[CRM Link] Dynamics 365 legitimationsoplysninger slettet fra Vault.";
        UpdateSystemHealth();
    }

    private void ConnectPg()
    {
        if (_useSupabase)
        {
            if (string.IsNullOrWhiteSpace(_pgHost) || string.IsNullOrWhiteSpace(_supabaseAnonKey))
            {
                _statusMessage = "[PostgreSQL Link] Alle Supabase-felter (Project URL, Anon API Key) skal udfyldes.";
                return;
            }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_pgHost) || string.IsNullOrWhiteSpace(_pgDatabase) || string.IsNullOrWhiteSpace(_pgUsername) || string.IsNullOrWhiteSpace(_pgPassword))
            {
                _statusMessage = "[PostgreSQL Link] Alle PostgreSQL-felter (Host, Database, Brugernavn, Password) skal udfyldes.";
                return;
            }
        }

        _pgConnected = true;
        StateContainer.IsPostgresConnected = true;
        StateContainer.PostgresHost = _pgHost;
        StateContainer.PostgresPort = _pgPort;
        StateContainer.PostgresDatabase = _pgDatabase;
        StateContainer.PostgresUsername = _pgUsername;
        StateContainer.PostgresPassword = _pgPassword;
        StateContainer.UseSupabase = _useSupabase;
        StateContainer.SupabaseAnonKey = _supabaseAnonKey;
        
        if (_useSupabase)
        {
            _statusMessage = $"[PostgreSQL Link] Forbindelse etableret! Sikker HTTPS PostgREST-forbindelse oprettet til {_pgHost}.";
        }
        else
        {
            _statusMessage = $"[PostgreSQL Link] Forbindelse etableret! Sikker krypteret SSL-tunnel oprettet til {_pgHost}:{_pgPort}.";
        }
        UpdateSystemHealth();
    }

    private void DisconnectPg()
    {
        _pgConnected = false;
        StateContainer.IsPostgresConnected = false;
        StateContainer.UseSupabase = false;
        _useSupabase = false;
        _supabaseAnonKey = "";
        StateContainer.SupabaseAnonKey = "";
        _statusMessage = "[PostgreSQL Link] PostgreSQL-synkronisering deaktiveret.";
        UpdateSystemHealth();
    }

