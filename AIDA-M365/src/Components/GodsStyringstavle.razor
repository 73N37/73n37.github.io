@page "/home"
@implements IDisposable
@using AIDA.M365.Models
@using Microsoft.AspNetCore.Components
@using MudBlazor
@inject AIDA.M365.Services.IGodsDatabaseService DatabaseService
@inject AIDA.M365.Services.IntegrationStateContainer StateContainer
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6" Style="background: transparent;">
    <MudStack Spacing="6">
        
        <!-- Header Command Center Banner with responsive gradient and text styling -->
        <MudPaper Class="pa-6 rounded-lg" Elevation="4" Style="background: linear-gradient(135deg, #070A13 0%, #0F172A 35%, #064E3B 75%, #854D0E 100%); color: white; border: 1px solid rgba(255,255,255,0.05); position: relative; overflow: hidden;">
            <div style="position: absolute; top: -50px; right: -50px; width: 250px; height: 250px; background: radial-gradient(circle, rgba(212,175,55,0.15) 0%, rgba(212,175,55,0) 70%); border-radius: 50%; pointer-events: none;"></div>
            <MudGrid AlignItems="AlignItems.Center">
                <MudItem xs="12" md="8">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h3" Class="brand-text font-weight-bold" Style="letter-spacing: -1px; color: #FAF9F6; text-shadow: 0 2px 4px rgba(0,0,0,0.15);">Gods Styringstavle & Afvikling</MudText>
                        <MudText Typo="Typo.subtitle1" Style="color: #E2E8F0; font-weight: 300;">
                            Strategisk selskabsstyring til afvikling af bryllupper, konferencer og private fester på Engestofte Gods.
                        </MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" md="4" Class="d-flex justify-md-end justify-start">
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Secondary" 
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenCreateDialog"
                                   Style="border-radius: 8px; font-weight: 600; padding: 10px 20px;">
                            Opret Selskab
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- KPI Metrics Grid -->
        <MudGrid>
            <!-- KPI 1: Active Bookings -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 rounded-lg glass-panel" Elevation="2" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Class="text-muted font-weight-bold" Style="letter-spacing: 0.5px;">AKTIVE SELSKABER</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold">@_cards.Count Selskaber</MudText>
                        </MudStack>
                        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium" Style="border-radius: 8px;">
                            <MudIcon Icon="@Icons.Material.Filled.Event" />
                        </MudAvatar>
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Success" Class="d-flex align-center mt-2 font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Class="mr-1" />
                        +1 Forespørgsel Afventer
                    </MudText>
                </MudPaper>
            </MudItem>

            <!-- KPI 2: Estimated Revenue -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 rounded-lg glass-panel" Elevation="2" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Class="text-muted font-weight-bold" Style="letter-spacing: 0.5px;">FORVENTET OMSÆTNING</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold text-success">@CalculateTotalRevenue()</MudText>
                        </MudStack>
                        <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Medium" Style="border-radius: 8px;">
                            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" />
                        </MudAvatar>
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="text-muted d-flex align-center mt-2">
                        Baseret på gæstepakker & forplejning
                    </MudText>
                </MudPaper>
            </MudItem>

            <!-- KPI 3: Total Guests -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 rounded-lg glass-panel" Elevation="2" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Class="text-muted font-weight-bold" Style="letter-spacing: 0.5px;">FORVENTEDE GÆSTER I ALT</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold">@_cards.Sum(c => c.GuestCount) Gæster</MudText>
                        </MudStack>
                        <MudAvatar Color="Color.Info" Variant="Variant.Filled" Size="Size.Medium" Style="border-radius: 8px;">
                            <MudIcon Icon="@Icons.Material.Filled.People" />
                        </MudAvatar>
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="text-muted d-flex align-center mt-2">
                        Belægning for lade & hovedbygning
                    </MudText>
                </MudPaper>
            </MudItem>

            <!-- KPI 4: Synchronisation Hub (dynamic) -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 rounded-lg glass-panel" Elevation="2" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Class="text-muted font-weight-bold" Style="letter-spacing: 0.5px;">INTEGRATIONSBROER</MudText>
                            @if (StateContainer.IsOutlookConnected)
                            {
                                <MudText Typo="Typo.h4" Class="font-weight-bold text-success">FORBUNDET</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.h4" Class="font-weight-bold" Style="color:#E74C3C;">AFBRUDT</MudText>
                            }
                        </MudStack>
                        <MudAvatar Color="@(StateContainer.IsOutlookConnected ? Color.Success : Color.Error)" Variant="Variant.Filled" Size="Size.Medium" Style="border-radius: 8px;">
                            <MudIcon Icon="@(StateContainer.IsOutlookConnected ? Icons.Material.Filled.CloudQueue : Icons.Material.Filled.CloudOff)" />
                        </MudAvatar>
                    </MudStack>
                    @if (StateContainer.IsOutlookConnected)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Success" Class="d-flex align-center mt-2 font-weight-bold">
                            <span class="pulse-indicator mr-2"></span>
                            Graph &amp; Gods synkronisering aktiv
                        </MudText>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="ReconnectWithoutLogout"
                                   Style="margin-top:8px; background:#E74C3C; color:white; border-radius:6px; font-weight:600; width:100%; font-size:0.75rem;">
                            Genforbind Kalender
                        </MudButton>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Reconnect banner — shown when logged in but Graph Calendar is unreachable (401 / wrong token) -->
        @if (!StateContainer.IsOutlookConnected && StateContainer.DidLastFetchSucceed == false)
        {
            <MudAlert Severity="Severity.Warning" Dense="false" Variant="Variant.Filled" Elevation="2"
                      Style="border-radius: 8px; font-weight: 500;">
                <MudStack Row="true" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Class="w-100">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2" Style="color:white; font-weight:700;">Kalender-forbindelsen kræver fornyet adgang</MudText>
                        <MudText Typo="Typo.body2" Style="color:rgba(255,255,255,0.85);">
                            Din Outlook-konto (@(StateContainer.LoggedInUser ?? "Microsoft-konto")) skal godkende kalenderadgang igen.
                            Klik 'Genforbind' for at logge ud og logge ind igen med de korrekte tilladelser.
                        </MudText>
                    </MudStack>
                    <MudButton Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Sync"
                               OnClick="ReconnectWithoutLogout"
                               Style="background:white; color:#E74C3C; font-weight:700; border-radius:8px; white-space:nowrap; flex-shrink:0;">
                        Genforbind
                    </MudButton>
                </MudStack>
            </MudAlert>
        }

        <!-- Main Alert Zone -->
        @if (!string.IsNullOrWhiteSpace(_lastUpdatedMessage))
        {
            <MudAlert Severity="Severity.Success" Dense="true" Variant="Variant.Filled" Elevation="2" Style="border-radius: 8px; font-weight: 500;">
                @_lastUpdatedMessage
            </MudAlert>
        }

        <!-- Upcoming Events Panel -->
        @{
            var upcomingEvents = _cards
                .Where(c => c.StartUtc >= DateTimeOffset.UtcNow)
                .OrderBy(c => c.StartUtc)
                .Take(5)
                .ToList();

            var todayEvents = _cards
                .Where(c => c.StartUtc.ToLocalTime().Date == DateTime.Today)
                .OrderBy(c => c.StartUtc)
                .ToList();
        }

        <MudPaper Class="pa-5 rounded-lg" Elevation="2" Style="background-color: white; border-top: 3px solid #D4AF37;">
            <MudStack Spacing="4">
                <!-- Section Header -->
                <MudStack Row="true" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Style="color: #D4AF37;" Size="Size.Large" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: #2C3E50;">Kommende Selskaber</MudText>
                            <MudText Typo="Typo.caption" Style="color: #7F8C8D;">
                                @if (todayEvents.Count > 0)
                                {
                                    <span style="color: #D4AF37; font-weight: 600;">@todayEvents.Count afvikling i dag · </span>
                                }
                                @upcomingEvents.Count kommende begivenheder
                            </MudText>
                        </MudStack>
                    </MudStack>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ArrowForward"
                               Href="/upcoming-events"
                               Style="border-radius: 8px; border-color: #2C3E50; color: #2C3E50; font-weight: 600;">
                        Se Kalender
                    </MudButton>
                </MudStack>

                <MudDivider />

                @if (upcomingEvents.Count == 0)
                {
                    <!-- Empty state -->
                    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="py-6">
                        <MudIcon Icon="@Icons.Material.Filled.EventBusy" Style="color: #BDC3C7; font-size: 3rem;" />
                        <MudText Typo="Typo.body2" Style="color: #7F8C8D;">Ingen kommende selskaber planlagt endnu</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog"
                                   Style="border-radius: 8px; font-weight: 600; background-color: #D4AF37; color: white;">
                            Opret Første Selskab
                        </MudButton>
                    </MudStack>
                }
                else
                {
                    <MudStack Spacing="2">
                        @foreach (var card in upcomingEvents)
                        {
                            var isToday = card.StartUtc.ToLocalTime().Date == DateTime.Today;
                            var isTomorrow = card.StartUtc.ToLocalTime().Date == DateTime.Today.AddDays(1);
                            var accentColor = card.EventSubtype switch
                            {
                                "Bryllup" or "Wedding"     => "#D4AF37",
                                "Jagt & Event"             => "#EF4444",
                                "Konference" or "Conference" => "#3B82F6",
                                "Privat Fest" or "Birthday"  => "#8B5CF6",
                                _                          => "#10B981"
                            };
                            var typeLabel = card.EventSubtype switch
                            {
                                "Wedding"    => "Bryllup",
                                "Birthday"   => "Privat Fest",
                                "Conference" => "Konference",
                                _            => card.EventSubtype ?? "Selskab"
                            };
                            var sectionLabel = card.SectionKey switch
                            {
                                "inquiry"     => "Henvendelse",
                                "quoted"      => "Tilbud Sendt",
                                "confirmed"   => "Bekræftet",
                                "preparation" => "Planlægning",
                                "active"      => "Afvikling",
                                "completed"   => "Afsluttet",
                                _             => card.SectionKey
                            };

                            <MudPaper Class="pa-4 rounded-lg hover-card"
                                      Outlined="true"
                                      Style="@($"background-color: white; border-left: 4px solid {accentColor}; cursor: pointer; transition: box-shadow 0.15s ease;")"
                                      @onclick="GoToCalendar">
                                <MudGrid AlignItems="AlignItems.Center" Spacing="2">

                                    <!-- Date Column -->
                                    <MudItem xs="12" sm="2">
                                        <MudPaper Class="pa-3 rounded-lg text-center" Elevation="0"
                                                  Style="@($"background-color: {accentColor}15; border: 1px solid {accentColor}30;")">
                                            <MudText Typo="Typo.h5" Class="font-weight-bold" Style="@($"color: {accentColor}; line-height: 1;")">
                                                @card.StartUtc.ToLocalTime().Day
                                            </MudText>
                                            <MudText Typo="Typo.caption" Style="color: #7F8C8D; text-transform: uppercase; font-weight: 600; font-size: 0.65rem;">
                                                @card.StartUtc.ToLocalTime().ToString("MMM", new System.Globalization.CultureInfo("da-DK"))
                                            </MudText>
                                            @if (isToday)
                                            {
                                                <MudChip Size="Size.Small" Style="@($"background-color: {accentColor}; color: white; font-size: 0.6rem; height: 18px; margin-top: 4px; font-weight: bold;")" DisableRipple="true">I DAG</MudChip>
                                            }
                                            else if (isTomorrow)
                                            {
                                                <MudChip Size="Size.Small" Style="background-color: #F59E0B; color: white; font-size: 0.6rem; height: 18px; margin-top: 4px; font-weight: bold;" DisableRipple="true">I MORGEN</MudChip>
                                            }
                                        </MudPaper>
                                    </MudItem>

                                    <!-- Event Info Column -->
                                    <MudItem xs="12" sm="5">
                                        <MudStack Spacing="1">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <MudChip Size="Size.Small" DisableRipple="true"
                                                         Style="@($"background-color: {accentColor}20; color: {accentColor}; font-weight: 700; font-size: 0.7rem; height: 20px;")">
                                                    @typeLabel
                                                </MudChip>
                                                <MudChip Size="Size.Small" DisableRipple="true"
                                                         Style="background-color: #F1F5F9; color: #64748B; font-size: 0.65rem; height: 20px;">
                                                    @sectionLabel
                                                </MudChip>
                                            </MudStack>
                                            <MudText Typo="Typo.body1" Class="font-weight-bold" Style="color: #2C3E50;">
                                                @card.Subject
                                            </MudText>
                                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Style="color: #7F8C8D; font-size: 0.85rem;" />
                                                <MudText Typo="Typo.caption" Style="color: #7F8C8D;">
                                                    @card.StartUtc.ToLocalTime().ToString("HH:mm") – @card.EndUtc.ToLocalTime().ToString("HH:mm")
                                                </MudText>
                                            </MudStack>
                                        </MudStack>
                                    </MudItem>

                                    <!-- Location + Guests Column -->
                                    <MudItem xs="12" sm="3">
                                        <MudStack Spacing="1">
                                            @if (!string.IsNullOrWhiteSpace(card.EstateArea))
                                            {
                                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                                    <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Style="color: #7F8C8D; font-size: 0.9rem;" />
                                                    <MudText Typo="Typo.body2" Style="color: #2C3E50; font-weight: 500;">@card.EstateArea</MudText>
                                                </MudStack>
                                            }
                                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Style="color: #7F8C8D; font-size: 0.9rem;" />
                                                <MudText Typo="Typo.body2" Style="color: #2C3E50;">@card.GuestCount gæster</MudText>
                                            </MudStack>
                                            @if (!string.IsNullOrWhiteSpace(card.AssignedCoordinator))
                                            {
                                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Style="color: #7F8C8D; font-size: 0.9rem;" />
                                                    <MudText Typo="Typo.caption" Style="color: #7F8C8D;">@card.AssignedCoordinator</MudText>
                                                </MudStack>
                                            }
                                        </MudStack>
                                    </MudItem>

                                    <!-- Price Column -->
                                    <MudItem xs="12" sm="2" Class="d-flex justify-sm-end justify-start">
                                        @if (card.Price.HasValue && card.Price.Value > 0)
                                        {
                                            <MudStack Spacing="0" AlignItems="AlignItems.End">
                                                <MudText Typo="Typo.caption" Style="color: #7F8C8D; font-weight: 600; letter-spacing: 0.5px;">PRIS</MudText>
                                                <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: #D4AF37;">
                                                    @card.Price.Value.ToString("N0") kr.
                                                </MudText>
                                            </MudStack>
                                        }
                                        else
                                        {
                                            <MudStack Spacing="0" AlignItems="AlignItems.End">
                                                <MudText Typo="Typo.caption" Style="color: #BDC3C7;">Ingen pris</MudText>
                                            </MudStack>
                                        }
                                    </MudItem>

                                </MudGrid>
                            </MudPaper>
                        }
                    </MudStack>
                }
            </MudStack>
        </MudPaper>

        <!-- Kanban Board Component -->
        <GodsKanbanBoard Sections="_sections" Cards="_cards" CardUpdated="OnCardUpdatedAsync" SectionDeleted="OnSectionDeletedAsync" CardDeleted="OnCardDeletedAsync" />
    </MudStack>
</MudContainer>

<MudDialog @bind-IsVisible="_showCreateSectionDialog" Options="new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small }">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold">Opret Nyt Selskabsstadie</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_newSectionTitle"
                          Label="Titel"
                          Placeholder="f.eks. Reserveret, Depositum Betalt"
                          FullWidth="true"
                          Variant="Variant.Outlined" />
            
            <MudNumericField @bind-Value="_dayOffsetFromToday"
                             Label="Dato Offset (0 = i dag, 1 = i morgen)"
                             Min="-7"
                             Max="7"
                             FullWidth="true"
                             Variant="Variant.Outlined" />
            
            <MudNumericField @bind-Value="_startHourUtc"
                             Label="Starttime (UTC 0-23)"
                             Min="0"
                             Max="23"
                             FullWidth="true"
                             Variant="Variant.Outlined" />
            
            <MudNumericField @bind-Value="_startMinuteUtc"
                             Label="Startminut (0-59)"
                             Min="0"
                             Max="59"
                             FullWidth="true"
                             Variant="Variant.Outlined" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showCreateSectionDialog = false" Style="border-radius: 8px;">Annuller</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateSectionAsync" Style="border-radius: 8px; font-weight: bold;">Opret</MudButton>
    </DialogActions>
</MudDialog>



<style>
    .pulse-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: var(--mud-palette-success);
        box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.7);
        animation: pulse 1.5s infinite;
        display: inline-block;
    }

    @@keyframes pulse {
        0% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.7);
        }
        70% {
            transform: scale(1);
            box-shadow: 0 0 0 6px rgba(76, 175, 80, 0);
        }
        100% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(76, 175, 80, 0);
        }
    }
</style>

@code {
    private readonly List<GodsKanbanSection> _sections =
    [
        new()
        {
            Key = "inquiry",
            Title = "Henvendelser",
            DayOffsetFromTodayUtc = 2,
            StartHourUtc = 9,
            StartMinuteUtc = 0
        },
        new()
        {
            Key = "quoted",
            Title = "Sendte Tilbud",
            DayOffsetFromTodayUtc = 1,
            StartHourUtc = 10,
            StartMinuteUtc = 0
        },
        new()
        {
            Key = "confirmed",
            Title = "Bekræftede Bookinger",
            DayOffsetFromTodayUtc = 0,
            StartHourUtc = 11,
            StartMinuteUtc = 0
        },
        new()
        {
            Key = "preparation",
            Title = "Planlægning",
            DayOffsetFromTodayUtc = 0,
            StartHourUtc = 8,
            StartMinuteUtc = 0
        },
        new()
        {
            Key = "active",
            Title = "Afvikling",
            DayOffsetFromTodayUtc = 0,
            StartHourUtc = 14,
            StartMinuteUtc = 0
        },
        new()
        {
            Key = "completed",
            Title = "Afsluttet",
            DayOffsetFromTodayUtc = 0,
            StartHourUtc = 18,
            StartMinuteUtc = 0
        }
    ];

    private List<GodsEventCard> _cards = [];

    private string? _lastUpdatedMessage;

    // Dialog state for creating new sections
    private bool _showCreateSectionDialog;
    private string? _newSectionTitle;
    private int _dayOffsetFromToday;
    private int _startHourUtc;
    private int _startMinuteUtc;

    // Opret Selskab Form State variables
    private bool _isStaffView = true;

    protected override async Task OnInitializedAsync()
    {
        StateContainer.OnChange += OnStateChanged;
        await LoadEventsAsync();
    }

    private async Task LoadEventsAsync()
    {
        var events = await DatabaseService.FetchAllEventsAsync();
        if (events.Count == 0)
        {
            _lastUpdatedMessage = "[System] Henter planlagte selskaber og seeder demodata...";
            await DatabaseService.SeedDemoDataToDbAsync();
            events = await DatabaseService.FetchAllEventsAsync();
        }
        _cards = new List<GodsEventCard>(events);
        StateHasChanged();
    }

    private void OnStateChanged()
    {
        // Re-render the UI when shared state changes (dark mode, connection status, etc.)
        // Do NOT call LoadEventsAsync here — that would cause an infinite loop since
        // FetchAllEventsAsync itself modifies state (Cards, DidLastFetchSucceed) which
        // would fire this handler again on every single fetch.
        InvokeAsync(() =>
        {
            _cards = new List<GodsEventCard>(StateContainer.Cards);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        StateContainer.OnChange -= OnStateChanged;
    }

    private string CalculateTotalRevenue()
    {
        double revenue = 0;
        foreach (var card in _cards)
        {
            if (card.GraphEventId == "event-fail") continue; // Exclude mock error card

            if (card.Price.HasValue)
            {
                revenue += (double)card.Price.Value;
            }
            else
            {
                double basePrice = 12000;
                if (card.EventSubtype == "Wedding" || card.EventSubtype == "Bryllup") basePrice = 35000;
                else if (card.EventSubtype == "Birthday" || card.EventSubtype == "Privat Fest") basePrice = 18000;
                else if (card.EventSubtype == "Conference" || card.EventSubtype == "Konference") basePrice = 15000;
                else if (card.EventSubtype == "Jagt & Event") basePrice = 25000;

                double perGuestPrice = 450;
                if (card.CateringOption == "Fine Dining" || card.CateringOption == "Gourmet Selskabsmenu") perGuestPrice = 1250;
                else if (card.CateringOption == "Buffet & Mocktails" || card.CateringOption == "Konference-dagsmenu") perGuestPrice = 650;
                else if (card.CateringOption == "Champagne Brunch" || card.CateringOption == "Brunch & Champagne") perGuestPrice = 850;

                revenue += basePrice + (card.GuestCount * perGuestPrice);
            }
        }
        return $"{revenue:N0} DKK";
    }

    private Task OpenCreateSectionDialogAsync()
    {
        _newSectionTitle = null;
        _dayOffsetFromToday = 0;
        _startHourUtc = 9;
        _startMinuteUtc = 0;
        
        _showCreateSectionDialog = true;
        return Task.CompletedTask;
    }

    private Task CreateSectionAsync()
    {
        if (string.IsNullOrWhiteSpace(_newSectionTitle))
        {
            return Task.CompletedTask;
        }

        var key = _newSectionTitle.ToLowerInvariant().Replace(" ", "-");
        
        if (_sections.Any(s => s.Key == key))
        {
            key = $"{key}-{DateTime.Now.Ticks}";
        }

        var newSection = new GodsKanbanSection
        {
            Key = key,
            Title = _newSectionTitle,
            DayOffsetFromTodayUtc = _dayOffsetFromToday,
            StartHourUtc = _startHourUtc,
            StartMinuteUtc = _startMinuteUtc
        };

        _sections.Add(newSection);
        _lastUpdatedMessage = $"Oprettede ny kolonne: {newSection.Title}";
        _showCreateSectionDialog = false;
        StateHasChanged();

        return Task.CompletedTask;
    }

    private async Task OnCardUpdatedAsync(GodsEventCard card)
    {
        await DatabaseService.SaveEventAsync(card);

        // Read from the optimistically-updated state container — do NOT re-fetch from
        // Outlook here. Outlook has eventual consistency; a re-fetch immediately after
        // save returns stale data and makes the card disappear for ~0.5 s.
        _cards = new List<GodsEventCard>(StateContainer.Cards);

        _lastUpdatedMessage =
            $"[Synkronisering] Opdaterede '{card.Subject}' → {card.StartUtc.ToLocalTime():g} i kolonnen '{card.SectionKey}'.";

        StateHasChanged();
    }

    private async Task OnSectionDeletedAsync(GodsKanbanSection section)
    {
        var cardsInDeletedSection = _cards.Where(c => c.SectionKey == section.Key).ToList();
        foreach (var card in cardsInDeletedSection)
        {
            await DatabaseService.DeleteEventAsync(card.GraphEventId);
        }

        // Use optimistic state — DeleteEventAsync already removed the cards from StateContainer.
        _cards = new List<GodsEventCard>(StateContainer.Cards);

        _sections.Remove(section);
        _lastUpdatedMessage = $"Slettede kolonnen: {section.Title}";
        StateHasChanged();
    }

    private async Task OnCardDeletedAsync(GodsEventCard card)
    {
        await DatabaseService.DeleteEventAsync(card.GraphEventId);

        // Use optimistic state — DeleteEventAsync already removed the card from StateContainer.
        _cards = new List<GodsEventCard>(StateContainer.Cards);

        _lastUpdatedMessage = $"[System] Selskabet '{card.Subject}' blev slettet permanent.";
        StateHasChanged();
    }

    private void GoToCalendar() => NavigationManager.NavigateTo("/upcoming-events");

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            [nameof(AIDA.M365.Components.Dialogs.GodsEventDialog.IsStaffView)] = _isStaffView
        };
        var options = new DialogOptions
        {
            MaxWidth             = MaxWidth.Small,
            FullWidth            = true,
            CloseButton          = true,
            DisableBackdropClick = false
        };

        var title = _isStaffView ? "Opret Selskab" : "Send Forespørgsel om Reservation";
        var dialog = await DialogService.ShowAsync<AIDA.M365.Components.Dialogs.GodsEventDialog>(title, parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled) return;

        var data = (AIDA.M365.Components.Dialogs.GodsEventDialog.NewEventData)result.Data!;
        await SaveNewReservationFromDialog(data);
    }

    private async Task SaveNewReservationFromDialog(AIDA.M365.Components.Dialogs.GodsEventDialog.NewEventData data)
    {
        // Validation is handled inside GodsEventDialog before calling Close(Ok(...)).
        // Here we just map the result to a GodsEventCard and persist it.

        string targetSection = _isStaffView ? "confirmed" : "inquiry";
        string targetPriority = "Normal";
        string targetColor = "#10B981"; // default emerald
        
        if (string.Equals(data.Subtype, "Bryllup", StringComparison.OrdinalIgnoreCase))
        {
            targetColor    = "#D4AF37";
            targetPriority = "High";
        }
        else if (string.Equals(data.Subtype, "Jagt & Event", StringComparison.OrdinalIgnoreCase))
        {
            targetColor    = "#EF4444";
            targetPriority = "High";
        }

        var newCard = new GodsEventCard
        {
            GraphEventId        = $"evt-{Guid.NewGuid()}",
            MetadataId          = Guid.NewGuid(),
            Subject             = data.Subject,
            BodyContent         = $"Nyt selskab oprettet direkte fra Godstavlen. Område: {data.Area}, Forplejning: {data.Catering}.",
            ColorHex            = targetColor,
            Priority            = targetPriority,
            SectionKey          = targetSection,
            StartUtc            = data.StartUtc,
            EndUtc              = data.EndUtc,
            EventSubtype        = data.Subtype,
            GuestCount          = data.GuestCount,
            AssignedCoordinator = _isStaffView ? data.Coordinator : "Afventer godkendelse",
            EstateArea          = data.Area,
            CateringOption      = data.Catering,
            Price               = data.Price
        };

        await DatabaseService.SaveEventAsync(newCard);

        // Read from the optimistically-updated state container — do NOT re-fetch from
        // Outlook immediately after creating an event. Outlook has eventual consistency;
        // a re-fetch right after save returns stale data (without the new event)
        // making the card appear for ~0.5 s and then disappear. The background sync
        // via Graph API will update Outlook asynchronously.
        _cards = new List<GodsEventCard>(StateContainer.Cards);

        _lastUpdatedMessage = _isStaffView
            ? $"[Succes] Selskabet '{newCard.Subject}' blev oprettet og lagt i kolonnen '{newCard.SectionKey}'."
            : $"[Succes] Forespørgsel om '{newCard.Subject}' blev indsendt til godkendelse.";

        StateHasChanged();
    }

