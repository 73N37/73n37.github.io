@using AIDA.M365.Models
@using AIDA.M365.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@using MudBlazor
@inject IGodsCommandCenterService CommandCenterService
@inject ISnackbar Snackbar
@inject ILogger<GodsKanbanBoard> Logger
@inject IDialogService DialogService

<MudPaper Class="position-relative pa-0" Elevation="0" Style="background: transparent;">
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" Variant="Variant.Filled" Style="border-radius: 8px;">
            @_errorMessage
        </MudAlert>
    }

    <MudDropContainer T="GodsEventCard"
                      Items="Cards"
                      ItemsSelector="@((item, zoneKey) => item.SectionKey == zoneKey)"
                      ItemUpdated="HandleItemUpdatedAsync"
                      Class="d-flex flex-column gap-4">
        <ChildContent>
            <MudGrid>
                @foreach (var sectionDef in Sections)
                {
                    <MudItem xs="12" md="4">
                        <MudPaper Class="pa-4 glass-panel" Elevation="2" Style="border-radius: 12px; min-height: 400px; display: flex; flex-direction: column;">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-4">
                                <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold flex-grow-1">@sectionDef.Title</MudText>
                            </MudStack>
                            <MudDropZone T="GodsEventCard"
                                         Identifier="@sectionDef.Key"
                                         Class="mud-drop-zone flex-grow-1" />
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </ChildContent>

        <ItemRenderer Context="card">
            @{
                var isUpdating = _updatingCardIds.Contains(card.GraphEventId);
            }
            <MudPaper Class="pa-4 mb-3 estate-card" Outlined="true" Style="@GetCardStyle(card)" Elevation="2">
                
                <!-- Ghost Card Preview Loading Spinner Overlay -->
                @if (isUpdating)
                {
                    <div class="ghost-card-overlay">
                        <MudStack AlignItems="AlignItems.Center" Spacing="1">
                            <MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary" />
                            <MudText Typo="Typo.caption" Color="Color.Primary" Class="font-weight-bold">Synkroniserer...</MudText>
                        </MudStack>
                    </div>
                }
 
                <MudStack Spacing="3">
                    <!-- Badges & Dynamics Links -->
                    <MudStack Row="true" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <MudStack Row="true" Spacing="1">
                            @if (!string.IsNullOrWhiteSpace(card.EventSubtype))
                            {
                                <MudChip Size="Size.Small" 
                                         Color="@(card.EventSubtype.Equals("Wedding", StringComparison.OrdinalIgnoreCase) || card.EventSubtype.Equals("Bryllup", StringComparison.OrdinalIgnoreCase) ? Color.Secondary : Color.Primary)" 
                                         Variant="Variant.Filled"
                                         Class="font-weight-bold px-2 py-0"
                                         Style="font-size: 0.72rem; border-radius: 6px;">
                                    @(card.EventSubtype.Equals("Wedding", StringComparison.OrdinalIgnoreCase) ? "Bryllup" : card.EventSubtype.Equals("Birthday", StringComparison.OrdinalIgnoreCase) ? "Privat Fest" : card.EventSubtype)
                                </MudChip>
                            }
                            @if (!string.IsNullOrWhiteSpace(card.Priority) && !card.Priority.Equals("High", StringComparison.OrdinalIgnoreCase) && !card.Priority.Equals("Høj", StringComparison.OrdinalIgnoreCase))
                            {
                                <MudChip Size="Size.Small" 
                                         Color="Color.Default" 
                                         Variant="Variant.Outlined"
                                         Style="font-size: 0.72rem; border-radius: 6px;">
                                    @(card.Priority.Equals("Normal", StringComparison.OrdinalIgnoreCase) ? "Normal" : card.Priority)
                                </MudChip>
                            }
                        </MudStack>
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="@(() => OpenEditDrawerAsync(card))"
                                   Style="border-radius: 6px; font-size: 0.7rem; font-weight: bold; text-transform: uppercase; padding: 2px 8px;">
                            Rediger
                        </MudButton>
                        @if (card.IsEconomicInvoiceBooked)
                        {
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Filled"
                                       Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.Receipt"
                                       Href="@card.EconomicPaymentLink"
                                       Target="_blank"
                                       Style="border-radius: 6px; font-size: 0.7rem; font-weight: bold; text-transform: uppercase; padding: 2px 8px; margin-left: 4px;">
                                ERP #@card.EconomicInvoiceNumber
                            </MudButton>
                        }
                    </MudStack>
 
                    <!-- Event Subject -->
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Style="font-size: 0.95rem;">@card.Subject</MudText>
                    
                    <!-- Booking Date & Time -->
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="text-muted">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" Color="Color.Default" Style="opacity: 0.7;" />
                        <MudText Typo="Typo.caption" Class="font-weight-bold">
                            @card.StartUtc.ToLocalTime().ToString("dd. MMM yyyy, HH:mm", new System.Globalization.CultureInfo("da-DK")) - @card.EndUtc.ToLocalTime().ToString("HH:mm")
                        </MudText>
                    </MudStack>
 
                    <!-- Estate Rental Details Grid -->
                    <div style="background-color: var(--mud-palette-background-grey); padding: 8px 12px; border-radius: 8px;">
                        <MudGrid Spacing="1">
                            @if (!string.IsNullOrWhiteSpace(card.EstateArea))
                            {
                                <MudItem xs="6">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Color="Color.Primary" Style="opacity: 0.8;" />
                                        <MudText Typo="Typo.caption" Class="text-truncate font-weight-medium">@card.EstateArea</MudText>
                                    </MudStack>
                                </MudItem>
                            }
                            <MudItem xs="6">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Color="Color.Primary" Style="opacity: 0.8;" />
                                    <MudText Typo="Typo.caption" Class="font-weight-medium">@card.GuestCount Gæster</MudText>
                                </MudStack>
                            </MudItem>
                            @if (!string.IsNullOrWhiteSpace(card.AssignedCoordinator))
                            {
                                <MudItem xs="6">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Primary" Style="opacity: 0.8;" />
                                        <MudText Typo="Typo.caption" Class="text-truncate font-weight-medium">@card.AssignedCoordinator</MudText>
                                    </MudStack>
                                </MudItem>
                            }
                            @if (!string.IsNullOrWhiteSpace(card.CateringOption))
                            {
                                <MudItem xs="6">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Restaurant" Size="Size.Small" Color="Color.Primary" Style="opacity: 0.8;" />
                                        <MudText Typo="Typo.caption" Class="text-truncate font-weight-medium">@card.CateringOption</MudText>
                                    </MudStack>
                                </MudItem>
                            }
                        </MudGrid>
                    </div>
                    <!-- Price Badge -->
                    @if (card.Price.HasValue && card.Price.Value > 0)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="background: linear-gradient(135deg, rgba(212,175,55,0.12), rgba(212,175,55,0.06)); border: 1px solid rgba(212,175,55,0.3); border-radius: 8px; padding: 6px 12px;">
                            <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" Style="color: #D4AF37; opacity: 0.9;" />
                            <MudText Typo="Typo.caption" Class="font-weight-bold" Style="color: #D4AF37; font-size: 0.82rem; letter-spacing: 0.3px;">
                                @card.Price.Value.ToString("N0") kr.
                            </MudText>
                        </MudStack>
                    }
 
                    <!-- Action items Preview (Completed ones strikethrough) -->
                    @if (card.ActionItems.Count > 0)
                    {
                        <MudStack Spacing="1" Class="pl-1 mt-1">
                            <MudText Typo="Typo.caption" Color="Color.Primary" Class="font-weight-bold" Style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px;">AI Opgaver-oversigt:</MudText>
                            @{
                                var completedCount = card.ActionItems.Count(x => IsActionItemCompleted(card.GraphEventId, x));
                            }
                            <MudText Typo="Typo.caption" Class="text-muted" Style="font-size: 0.7rem; margin-top: -4px;">
                                @completedCount af @card.ActionItems.Count opgaver fuldført
                            </MudText>
                        </MudStack>
                    }
 
                    <!-- Actions -->
                    <MudStack Row="true" JustifyContent="JustifyContent.End" Class="mt-1">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.AutoAwesome"
                                   Disabled="@isUpdating"
                                   OnClick="@(() => SummarizeCardAsync(card))"
                                   Style="border-radius: 8px; font-weight: 500; font-size: 0.75rem; border: 1px solid rgba(16,185,129,0.25);">
                            AI Resumé
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </ItemRenderer>
    </MudDropContainer>
</MudPaper>

<!-- EDIT EVENT INQUIRY DETAILS DRAWER -->
<MudDrawer Anchor="Anchor.Right" @bind-Open="_editDrawerOpen" Width="450px" Elevation="16" Variant="DrawerVariant.Temporary" Style="border-radius: 16px 0 0 16px; overflow-y: auto;">
    <MudDrawerHeader Style="border-bottom: 1px solid rgba(255,255,255,0.06); background: #070A13; color: white; padding: 20px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Style="color: #D4AF37; font-size: 1.8rem;" />
            <div>
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Style="line-height: 1.2;">Rediger Selskab</MudText>
                <MudText Typo="Typo.caption" Class="text-muted" Style="font-size: 0.72rem;">Konfigurer metadata og prissætningsparametre</MudText>
            </div>
        </MudStack>
    </MudDrawerHeader>
    <div class="pa-6">
        @if (_editingCard is not null)
        {
            <MudStack Spacing="4">
                <MudTextField @bind-Value="_editingSubject" Label="Emne / Selskabsnavn" Variant="Variant.Outlined" Margin="Margin.Dense" />
                
                <MudSelect @bind-Value="_editingSubtype" Label="Kategori" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@("Wedding")">Bryllup</MudSelectItem>
                    <MudSelectItem Value="@("Birthday")">Privat Fest</MudSelectItem>
                    <MudSelectItem Value="@("Conference")">Konference</MudSelectItem>
                    <MudSelectItem Value="@("HuntEvent")">Jagt & Event</MudSelectItem>
                </MudSelect>

                <MudSelect @bind-Value="_editingArea" Label="Område" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@("Den Store Lade")">Den Store Lade</MudSelectItem>
                    <MudSelectItem Value="@("Hovedbygningen")">Hovedbygningen</MudSelectItem>
                    <MudSelectItem Value="@("Søparken")">Søparken</MudSelectItem>
                </MudSelect>

                <MudNumericField @bind-Value="_editingGuests" Label="Forventet Antal Gæster" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" />

                <MudSelect @bind-Value="_editingCatering" Label="Forplejning" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@("Gourmet Selskabsmenu")">Gourmet Selskabsmenu</MudSelectItem>
                    <MudSelectItem Value="@("Konference-dagsmenu")">Konference-dagsmenu</MudSelectItem>
                    <MudSelectItem Value="@("Brunch & Champagne")">Brunch & Champagne</MudSelectItem>
                </MudSelect>

                <MudTextField @bind-Value="_editingCoordinator" Label="Ansvarlig Koordinator" Variant="Variant.Outlined" Margin="Margin.Dense" />

                <MudNumericField @bind-Value="_editingPrice" Label="Samlet Selskabspris" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" HideSpinButtons="true" Format="N0" Adornment="Adornment.End" AdornmentText="kr." />

                <!-- Timetable / SubEvents Section inside Kanban Edit Drawer -->
                <MudPaper Class="pa-4 rounded-lg" Outlined="true" Style="background-color: white;">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2" Style="color: #2C3E50;">Dagens Program (Del-begivenheder)</MudText>
                    
                    @if (_editingCard.SubEvents == null || _editingCard.SubEvents.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Class="text-muted d-block mb-2">Ingen del-begivenheder planlagt endnu.</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="2" Class="mb-3">
                            @foreach (var sub in _editingCard.SubEvents.OrderBy(s => s.StartTime))
                            {
                                <MudPaper Class="pa-3 rounded-lg" Outlined="true" Style="background-color: #FAF9F6; border-left: 4px solid #D4AF37;">
                                    <MudStack Row="true" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body2" Class="font-weight-bold" Style="color: #2C3E50;">@sub.Title</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Style="font-size: 0.8rem; vertical-align: middle; margin-right: 2px;" />
                                                @sub.StartTime.ToString(@"hh\:mm") - @sub.EndTime.ToString(@"hh\:mm")
                                                <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Style="font-size: 0.8rem; vertical-align: middle; margin-left: 6px; margin-right: 2px;" />
                                                @sub.Location
                                            </MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="1">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="() => StartEditSubEvent(sub)" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteSubEvent(sub)" />
                                        </MudStack>
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    }

                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="color: #7F8C8D;">TILFØJ / REDIGER AKTIVITET</MudText>
                    <MudStack Spacing="2">
                        <MudTextField @bind-Value="_subTitle" Label="Titel på aktivitet" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudGrid Spacing="2">
                            <MudItem xs="6">
                                <MudTimePicker @bind-Time="_subStart" Label="Starttid" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTimePicker @bind-Time="_subEnd" Label="Sluttid" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>
                        <MudSelect @bind-Value="_subLocation" Label="Lokation" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="@("Den Store Lade")">Den Store Lade</MudSelectItem>
                            <MudSelectItem Value="@("Hovedbygningen")">Hovedbygningen</MudSelectItem>
                            <MudSelectItem Value="@("Søparken")">Søparken</MudSelectItem>
                        </MudSelect>
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SaveSubEvent" Style="background-color: #D4AF37; color: white; border-radius: 8px; font-weight: bold;">
                            @(_editingSubEventId.HasValue ? "Opdater Aktivitet" : "Tilføj Aktivitet")
                        </MudButton>
                        @if (_editingSubEventId.HasValue)
                        {
                            <MudButton Variant="Variant.Outlined" OnClick="CancelEditSubEvent" Style="border-radius: 8px;" Class="mt-1">Annuller redigering</MudButton>
                        }
                    </MudStack>
                </MudPaper>

                <MudDivider Style="background: rgba(255,255,255,0.06);" />

                <MudStack Row="true" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Style="width: 100%;">
                    <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteEventAsync" Style="border-radius: 8px; font-weight: bold;">Slet Selskab</MudButton>
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="CloseEditDrawer" Style="border-radius: 8px;">Annuller</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEditDetailsAsync" Style="border-radius: 8px; font-weight: bold;">Gem Ændringer</MudButton>
                    </MudStack>
                </MudStack>
            </MudStack>
        }
    </div>
</MudDrawer>

<!-- AZURE OPENAI SMART SUMMARY POPUP DIALOG -->
<MudDialog @bind-IsVisible="_showAiDialog" Options="_dialogOptions" Style="border-radius: 12px; overflow: hidden;">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Style="color: #D4AF37; font-size: 1.8rem;" />
            <div>
                <MudText Typo="Typo.h6" Class="font-weight-bold">AI Gods-Assistent</MudText>
                <MudText Typo="Typo.caption" Class="text-muted">Azure OpenAI GPT-4o integration</MudText>
            </div>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_selectedCardForSummary is not null)
        {
            <MudStack Spacing="4" Class="py-2">
                <MudPaper Class="pa-4" Style="background-color: rgba(16, 185, 129, 0.05); border-left: 4px solid var(--mud-palette-primary); border-radius: 8px;" Elevation="0">
                    <MudText Typo="Typo.body2" Class="font-italic" Style="line-height: 1.6;">
                        "@_selectedCardForSummary.SmartSummary"
                    </MudText>
                </MudPaper>
                
                <div>
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="Color.Primary" Style="text-transform: uppercase; letter-spacing: 0.5px;">Interaktiv Huskeliste</MudText>
                    <MudText Typo="Typo.caption" Class="text-muted">Afkryds opgaver i takt med planlægningen. Fremskridt gemmes direkte i databasen.</MudText>
                    
                    <MudStack Spacing="1" Class="mt-3">
                        @for (int i = 0; i < _actionItemsCopy.Count; i++)
                        {
                            var index = i;
                            var isChecked = _actionItemChecked[index];
                            <MudCheckBox T="bool" 
                                         Value="@isChecked" 
                                         ValueChanged="@((val) => OnActionItemCheckChanged(index, val))"
                                         Color="Color.Primary" 
                                         Dense="true">
                                <span style="@(isChecked ? "text-decoration: line-through; opacity: 0.5;" : "font-weight: 500;")">
                                    @_actionItemsCopy[index]
                                </span>
                            </MudCheckBox>
                        }
                    </MudStack>
                </div>
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseAiDialog" Style="border-radius: 8px;">Luk</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAiActionItemsAsync" Style="border-radius: 8px; font-weight: bold;">Gem Fremskridt</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired]
    public required IList<GodsKanbanSection> Sections { get; set; }

    [Parameter, EditorRequired]
    public required IList<GodsEventCard> Cards { get; set; }

    [Parameter]
    public EventCallback<GodsEventCard> CardUpdated { get; set; }

    [Parameter]
    public EventCallback<GodsKanbanSection> SectionDeleted { get; set; }

    [Parameter]
    public EventCallback<GodsEventCard> CardDeleted { get; set; }

    private readonly HashSet<string> _updatingCardIds = new();
    private string? _errorMessage;

    // Live Inquiry Editor Drawer variables
    private bool _editDrawerOpen;
    private GodsEventCard? _editingCard;
    private string _editingSubject = string.Empty;
    private string _editingSubtype = string.Empty;
    private string _editingArea = string.Empty;
    private int _editingGuests = 1;
    private string _editingCatering = string.Empty;
    private string _editingCoordinator = string.Empty;
    private decimal? _editingPrice;

    // Inline SubEvent variables inside Edit Drawer
    private string _subTitle = string.Empty;
    private TimeSpan? _subStart = new TimeSpan(12, 0, 0);
    private TimeSpan? _subEnd = new TimeSpan(13, 0, 0);
    private string _subLocation = "Den Store Lade";
    private Guid? _editingSubEventId;

    // OpenAI Smart Summary Dialog variables
    private bool _showAiDialog;
    private GodsEventCard? _selectedCardForSummary;
    private List<string> _actionItemsCopy = new();
    private List<bool> _actionItemChecked = new();
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    // In-memory Azure SQL custom metadata simulation for checklist item completion
    private readonly Dictionary<(string CardId, string ActionText), bool> _actionItemsCompleted = new();

    private async Task HandleItemUpdatedAsync(MudItemDropInfo<GodsEventCard> dropInfo)
    {
        var card = dropInfo.Item;
        if (card is null)
        {
            Logger.LogWarning("Received a drop update without an item.");
            return;
        }

        var destinationSection = Sections.FirstOrDefault(x => x.Key == dropInfo.DropzoneIdentifier);

        if (destinationSection is null)
        {
            Logger.LogWarning("Unknown drop zone identifier: {DropzoneIdentifier}", dropInfo.DropzoneIdentifier);
            return;
        }

        var originalSectionKey = card.SectionKey;
        var originalStart = card.StartUtc;
        var originalEnd = card.EndUtc;

        var (newStartUtc, newEndUtc) = RecalculateTimes(card, destinationSection);

        // OPTIMISTIC UPDATE: Instantly shift position in local UI
        card.SectionKey = destinationSection.Key;
        card.StartUtc = newStartUtc;
        card.EndUtc = newEndUtc;

        // Display "Ghost Card Preview" loader inside the card (non-blocking)
        _updatingCardIds.Add(card.GraphEventId);
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var result = await CommandCenterService.MoveCardAsync(
                new EventCardMoveRequest(card, destinationSection.Key, newStartUtc, newEndUtc));

            if (!result.Succeeded)
            {
                // Rollback on failure
                RollbackCard(card, originalSectionKey, originalStart, originalEnd);
                _errorMessage = result.ErrorMessage;
                Snackbar.Add($"API-synkronisering mislykkedes: {result.ErrorMessage}", Severity.Error);
                return;
            }

            if (CardUpdated.HasDelegate)
            {
                await CardUpdated.InvokeAsync(card);
            }

            // SUCCESS FEEDBACK with active UNDO trigger
            Snackbar.Add($"Flyttede '{card.Subject}' til {destinationSection.Title}", Severity.Success, config =>
            {
                config.Action = "FORTRYD";
                config.ActionColor = Color.Warning;
                config.Onclick = async snackbar =>
                {
                    await RevertMoveAsync(card, originalSectionKey, originalStart, originalEnd);
                };
            });
        }
        catch (Exception ex)
        {
            // Rollback on exceptions
            RollbackCard(card, originalSectionKey, originalStart, originalEnd);
            _errorMessage = "Aftalen kunne ikke synkroniseres med Microsoft 365.";
            Snackbar.Add(_errorMessage, Severity.Error);
            Logger.LogError(ex, "Failed to update event {EventId}", card.GraphEventId);
        }
        finally
        {
            _updatingCardIds.Remove(card.GraphEventId);
            StateHasChanged();
        }
    }

    private void RollbackCard(GodsEventCard card, string origSection, DateTimeOffset origStart, DateTimeOffset origEnd)
    {
        card.SectionKey = origSection;
        card.StartUtc = origStart;
        card.EndUtc = origEnd;
    }

    private async Task RevertMoveAsync(GodsEventCard card, string targetSectionKey, DateTimeOffset targetStart, DateTimeOffset targetEnd)
    {
        // Revert local UI state optimistically
        var originalSectionKey = card.SectionKey;
        var originalStart = card.StartUtc;
        var originalEnd = card.EndUtc;

        card.SectionKey = targetSectionKey;
        card.StartUtc = targetStart;
        card.EndUtc = targetEnd;

        _updatingCardIds.Add(card.GraphEventId);
        StateHasChanged();

        try
        {
            var result = await CommandCenterService.MoveCardAsync(
                new EventCardMoveRequest(card, targetSectionKey, targetStart, targetEnd));

            if (!result.Succeeded)
            {
                RollbackCard(card, originalSectionKey, originalStart, originalEnd);
                Snackbar.Add($"Fortryd mislykkedes: {result.ErrorMessage}", Severity.Error);
                return;
            }

            if (CardUpdated.HasDelegate)
            {
                await CardUpdated.InvokeAsync(card);
            }

            Snackbar.Add("Planlægningsændring blev annulleret.", Severity.Info);
        }
        catch (Exception ex)
        {
            RollbackCard(card, originalSectionKey, originalStart, originalEnd);
            Snackbar.Add("Kunne ikke gennemføre fortryd-transaktionen.", Severity.Error);
            Logger.LogError(ex, "Undo move failed for event {EventId}", card.GraphEventId);
        }
        finally
        {
            _updatingCardIds.Remove(card.GraphEventId);
            StateHasChanged();
        }
    }

    private static (DateTimeOffset StartUtc, DateTimeOffset EndUtc) RecalculateTimes(
        GodsEventCard card,
        GodsKanbanSection destinationSection)
    {
        var duration = card.Duration;
        var baseDayUtc = DateTimeOffset.UtcNow.Date.AddDays(destinationSection.DayOffsetFromTodayUtc);
        var newStartUtc = baseDayUtc
            .AddHours(destinationSection.StartHourUtc)
            .AddMinutes(destinationSection.StartMinuteUtc);

        return (newStartUtc, newStartUtc.Add(duration));
    }

