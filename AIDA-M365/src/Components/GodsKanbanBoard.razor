    private void StartEditSubEvent(SubEvent sub)
    {
        _editingSubEventId = sub.Id;
        _subTitle = sub.Title;
        _subStart = sub.StartTime;
        _subEnd = sub.EndTime;
        _subLocation = sub.Location;
    }

    private void CancelEditSubEvent()
    {
        _editingSubEventId = null;
        _subTitle = string.Empty;
        _subStart = new TimeSpan(12, 0, 0);
        _subEnd = new TimeSpan(13, 0, 0);
        _subLocation = "Den Store Lade";
    }

    private void SaveSubEvent()
    {
        if (_editingCard is null) return;

        if (string.IsNullOrWhiteSpace(_subTitle))
        {
            Snackbar.Add("Aktivitetstitel skal udfyldes.", Severity.Error);
            return;
        }

        if (!_subStart.HasValue || !_subEnd.HasValue)
        {
            Snackbar.Add("Start- og sluttid skal angives.", Severity.Error);
            return;
        }

        if (_subEnd.Value <= _subStart.Value)
        {
            Snackbar.Add("Sluttid skal være efter starttid.", Severity.Error);
            return;
        }

        if (_editingSubEventId.HasValue)
        {
            // Edit existing SubEvent
            var sub = _editingCard.SubEvents.FirstOrDefault(s => s.Id == _editingSubEventId.Value);
            if (sub != null)
            {
                sub.Title = _subTitle;
                sub.StartTime = _subStart.Value;
                sub.EndTime = _subEnd.Value;
                sub.Location = _subLocation;
                Snackbar.Add($"Del-begivenheden '{_subTitle}' blev opdateret.", Severity.Success);
            }
        }
        else
        {
            // Add new SubEvent
            var newSub = new SubEvent
            {
                Title = _subTitle,
                StartTime = _subStart.Value,
                EndTime = _subEnd.Value,
                Location = _subLocation
            };
            if (_editingCard.SubEvents == null)
            {
                _editingCard.SubEvents = [];
            }
            _editingCard.SubEvents.Add(newSub);
            Snackbar.Add($"Del-begivenheden '{_subTitle}' blev tilføjet til programmet.", Severity.Success);
        }

        CancelEditSubEvent();
        StateHasChanged();
    }

    private void DeleteSubEvent(SubEvent sub)
    {
        if (_editingCard is null) return;

        _editingCard.SubEvents.Remove(sub);
        Snackbar.Add($"Del-begivenheden '{sub.Title}' blev fjernet fra programmet.", Severity.Info);
        StateHasChanged();
    }

    // OpenAI Smart Summarize Dialog Implementation
    private async Task SummarizeCardAsync(GodsEventCard card)
    {
        _updatingCardIds.Add(card.GraphEventId);
        _errorMessage = null;

        try
        {
            var result = await CommandCenterService.SummarizeCardAsync(card);
            if (!result.Succeeded)
            {
                _errorMessage = result.ErrorMessage;
                Snackbar.Add($"AI Generering mislykkedes: {result.ErrorMessage}", Severity.Error);
                return;
            }

            card.SmartSummary = result.Summary;
            card.ActionItems = result.ActionItems;

            if (CardUpdated.HasDelegate)
            {
                await CardUpdated.InvokeAsync(card);
            }

            // Open the interactive dialog
            _selectedCardForSummary = card;
            _actionItemsCopy = card.ActionItems.ToList();
            _actionItemChecked = card.ActionItems.Select(x => IsActionItemCompleted(card.GraphEventId, x)).ToList();
            _showAiDialog = true;
        }
        catch (Exception ex)
        {
            _errorMessage = "AI Resumé mislykkedes.";
            Snackbar.Add(_errorMessage, Severity.Error);
            Logger.LogError(ex, "Failed to summarize event {EventId}", card.GraphEventId);
        }
        finally
        {
            _updatingCardIds.Remove(card.GraphEventId);
            StateHasChanged();
        }
    }

    private void OnActionItemCheckChanged(int index, bool val)
    {
        _actionItemChecked[index] = val;
    }

    private void CloseAiDialog()
    {
        _showAiDialog = false;
        _selectedCardForSummary = null;
    }

    private async Task SaveAiActionItemsAsync()
    {
        if (_selectedCardForSummary is null) return;

        for (int i = 0; i < _actionItemsCopy.Count; i++)
        {
            var key = (_selectedCardForSummary.GraphEventId, _actionItemsCopy[i]);
            _actionItemsCompleted[key] = _actionItemChecked[i];
        }

        Snackbar.Add("Opfølgningslisten er blevet opdateret i Gods-databasen.", Severity.Success);
        _showAiDialog = false;
        _selectedCardForSummary = null;

        if (CardUpdated.HasDelegate)
        {
            await CardUpdated.InvokeAsync(_selectedCardForSummary);
        }

        StateHasChanged();
    }

    private bool IsActionItemCompleted(string cardId, string actionText)
    {
        return _actionItemsCompleted.TryGetValue((cardId, actionText), out var completed) && completed;
    }

    private static string? GetCardStyle(GodsEventCard card) =>
        string.IsNullOrWhiteSpace(card.ColorHex)
            ? null
            : $"border-left: 5px solid {card.ColorHex};";
