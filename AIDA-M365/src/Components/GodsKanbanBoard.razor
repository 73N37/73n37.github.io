    private async Task DeleteEventAsync()
    {
        if (_editingCard is null) return;

        bool? result = await DialogService.ShowMessageBox(
            "Slet Selskab",
            $"Er du sikker på, at du vil slette selskabet '{_editingCard.Subject}'? Denne handling vil fjerne selskabet permanent.",
            yesText: "Slet", cancelText: "Annuller");

